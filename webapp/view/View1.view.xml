														</table:Column>
													</table:columns>
												</table:Table>
											</content>
										</Panel>
										<Panel headerText="Summary Output" expandable="false" expanded="true" class="fcrOutPanel" visible="{= ${ui>/allViewMode} === 'SUMMARY' }">
											<content>
												<VBox class="fcrSummaryWrap">
													<Panel headerText="Summary Table" expandable="true" expanded="true" class="fcrSubPanel">
														<content>
															<table:Table id="allSummaryTable" rows="{fcr>/allSummaryRows}" visibleRowCount="8" selectionMode="None" enableColumnReordering="true"
																enableCellFilter="true" class="fcrUiTable">
																<table:columns>
																	<table:Column width="10rem" sortProperty="glGroup" filterProperty="glGroup">
																		<table:label><Label text="G/L Group"/></table:label>
																		<table:template><Text text="{fcr>glGroup}"/></table:template>
																	</table:Column>
																	<table:Column width="20rem" sortProperty="groupName" filterProperty="groupName">
																		<table:label><Label text="G/L Group Text"/></table:label>
																		<table:template><Text text="{fcr>groupName}"/></table:template>
																	</table:Column>
																	<table:Column width="10rem" sortProperty="total" hAlign="End">
