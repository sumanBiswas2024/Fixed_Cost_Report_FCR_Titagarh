<mvc:View
	controllerName="Z_Fixed_Cost_Report_FCR.controller.View1"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout"
	xmlns:table="sap.ui.table"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns="sap.m"
	displayBlock="true">
	<App class="fcrApp">
		<pages>
			<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
				<content>
					<VBox class="fcrPage">
						<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
							<VBox class="fcrHeaderText">
								<ObjectStatus text="ZFI_FCR" state="Information" icon="sap-icon://business-objects-experience" class="fcrEyebrow"/>
								<Title text="Fixed Cost Report" level="H1" class="fcrTitle"/>
								<Text text="{ui>/periodText}" class="fcrSubtitle"/>
							</VBox>
							<ObjectStatus text="{ui>/lastRunText}" state="Success" icon="sap-icon://sys-enter-2" class="fcrRunStatus"/>
						</HBox>

						<VBox class="fcrParamWrap">
							<Button
								id="paramToggleBtn"
								class="fcrParamToggle"
								type="Transparent"
								press=".onToggleParams"
								icon="{= ${ui>/paramsExpanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }"
								tooltip="{= ${ui>/paramsExpanded} ? 'Collapse parameters' : 'Expand parameters' }"/>

							<layout:Grid
								id="paramGrid"
								visible="{ui>/paramsExpanded}"
								defaultSpan="XL12 L12 M12 S12"
								hSpacing="1"
								vSpacing="0"
								class="fcrParamGrid">
								<HBox wrap="Wrap" class="fcrParamRow" alignItems="End">
									<VBox class="fcrField fcrFieldCc">
										<Label text="Company Code" required="true"/>
										<Input value="{filters>/companyCode}" maxLength="4" placeholder="1000"/>
									</VBox>
									<VBox class="fcrField fcrFieldFy">
										<Label text="Fiscal Year" required="true"/>
										<DatePicker value="{filters>/fiscalYear}" valueFormat="yyyy" displayFormat="yyyy" placeholder="YYYY" change=".onFiscalYearChange"/>
									</VBox>
									<VBox class="fcrField fcrFieldPc">
										<Label text="Profit Centre"/>
										<MultiInput id="profitCentreInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onProfitCentreValueHelp" tokens="{filters>/profitCenters}" placeholder="Choose profit centres">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<VBox class="fcrField fcrFieldGlg">
										<Label text="GL Group"/>
										<MultiInput id="glGroupInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlGroupValueHelp" tokens="{filters>/glGroups}" placeholder="Choose GL groups">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<VBox class="fcrField fcrFieldQtr">
										<Label text="Quarter"/>
										<Select selectedKey="{filters>/quarter}" width="100%" change=".onQuarterChange" items="{lookups>/quarters}">
											<core:Item key="{lookups>key}" text="{lookups>text}"/>
										</Select>
									</VBox>
									<VBox class="fcrActionBox fcrFieldAct">
										<Label text=" "/>
										<HBox class="fcrActionRow">
											<Button icon="sap-icon://refresh" tooltip="Reset" press=".onReset"/>
											<Button text="Run" icon="sap-icon://filter" type="Emphasized" press=".onSearch"/>
										</HBox>
									</VBox>
								</HBox>
							</layout:Grid>
						</VBox>

						<layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="fcrKpiGrid">
							<VBox class="fcrKpi fcrKpiA">
								<Text text="Actual Fixed Cost"/>
								<ObjectNumber number="{ui>/totalActual}" unit="INR" state="Information"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiB">
								<Text text="Budget"/>
								<ObjectNumber number="{ui>/totalBudget}" unit="INR"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiV">
								<Text text="Variance"/>
								<ObjectNumber number="{ui>/totalVariance}" unit="INR" state="{ui>/varianceState}"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiP">
								<Text text="Variance %"/>
								<ObjectNumber number="{ui>/variancePct}" unit="%" state="{ui>/varianceState}"/>
							</VBox>
						</layout:Grid>

						<IconTabBar selectedKey="{ui>/selectedTab}" class="fcrTabs" expandable="false">
							<items>
								<IconTabFilter key="all" text="All" icon="sap-icon://table-view">
									<VBox class="fcrTabContent">
										<Toolbar design="Transparent" class="fcrTableToolbar">
											<Title text="All Fixed Cost Lines" level="H3"/>
											<ToolbarSpacer/>
											<SegmentedButton selectedKey="{ui>/allViewMode}">
												<items>
													<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://detail-view"/>
													<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://vertical-bar-chart"/>
												</items>
											</SegmentedButton>
										</Toolbar>

										<table:Table rows="{fcr>/allDetailRows}" visible="{= ${ui>/allViewMode} === 'DETAIL' }" visibleRowCount="9" selectionMode="None" enableColumnReordering="true" class="fcrUiTable">
											<table:columns>
												<table:Column width="7rem" sortProperty="fiscalYear" hAlign="Center">
													<table:label><Label text="Fiscal Year"/></table:label>
													<table:template><Text text="{fcr>fiscalYear}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="monthText">
													<table:label><Label text="Month"/></table:label>
													<table:template><Text text="{fcr>monthText}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="glGroup" filterProperty="glGroup">
													<table:label><Label text="GL Group"/></table:label>
													<table:template><ObjectStatus text="{fcr>glGroup}" state="Information"/></table:template>
												</table:Column>
												<table:Column width="7rem" sortProperty="glAccount" filterProperty="glAccount">
													<table:label><Label text="GL Account"/></table:label>
													<table:template><Text text="{fcr>glAccount}"/></table:template>
												</table:Column>
												<table:Column width="12rem" sortProperty="glName" filterProperty="glName">
													<table:label><Label text="GL Description"/></table:label>
													<table:template><Text text="{fcr>glName}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="profitCenter" filterProperty="profitCenter">
													<table:label><Label text="Profit Centre"/></table:label>
													<table:template><Text text="{fcr>profitCenter}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="budget" hAlign="End">
													<table:label><Label text="Budget"/></table:label>
													<table:template><ObjectNumber number="{fcr>budgetText}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="actual" hAlign="End">
													<table:label><Label text="Actual"/></table:label>
													<table:template><ObjectNumber number="{fcr>actualText}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="variance" hAlign="End">
													<table:label><Label text="Variance"/></table:label>
													<table:template><ObjectNumber number="{fcr>varianceText}" state="{fcr>varianceState}"/></table:template>
												</table:Column>
											</table:columns>
										</table:Table>

										<VBox visible="{= ${ui>/allViewMode} === 'SUMMARY' }" class="fcrSummaryWrap">
											<table:Table rows="{fcr>/allSummaryRows}" visibleRowCount="7" selectionMode="None" enableColumnReordering="true" class="fcrUiTable">
												<table:columns>
													<table:Column width="7rem" sortProperty="fiscalYear" hAlign="Center">
														<table:label><Label text="Fiscal Year"/></table:label>
														<table:template><Text text="{fcr>fiscalYear}"/></table:template>
													</table:Column>
													<table:Column width="8rem" sortProperty="monthText">
														<table:label><Label text="Month"/></table:label>
														<table:template><Text text="{fcr>monthText}"/></table:template>
													</table:Column>
													<table:Column width="8rem" sortProperty="glGroup">
														<table:label><Label text="GL Group"/></table:label>
														<table:template><ObjectStatus text="{fcr>glGroup}" state="Information"/></table:template>
													</table:Column>
													<table:Column width="16rem" sortProperty="groupName">
														<table:label><Label text="Group Description"/></table:label>
														<table:template><Text text="{fcr>groupName}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="variance" hAlign="End">
														<table:label><Label text="Variance"/></table:label>
														<table:template><ObjectNumber number="{fcr>varianceText}" state="{fcr>varianceState}"/></table:template>
													</table:Column>
												</table:columns>
											</table:Table>

											<Toolbar design="Transparent">
												<Title text="All Summary by GL Group, Fiscal Year and Month" level="H4"/>
												<ToolbarSpacer/>
												<ObjectStatus text="Variance" state="Information"/>
											</Toolbar>
											<VBox class="fcrChartPanel fcrFullChart">
											<viz:VizFrame id="allSummaryChart" width="100%" height="360px" vizType="column">
												<viz:dataset>
													<viz.data:FlattenedDataset data="{fcr>/allSummaryChart}">
														<viz.data:dimensions>
															<viz.data:DimensionDefinition name="GL Group / FY / Month" value="{fcr>name}"/>
														</viz.data:dimensions>
														<viz.data:measures>
															<viz.data:MeasureDefinition name="Variance" value="{fcr>variance}"/>
														</viz.data:measures>
													</viz.data:FlattenedDataset>
												</viz:dataset>
												<viz:feeds>
													<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Variance"/>
													<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="GL Group / FY / Month"/>
												</viz:feeds>
											</viz:VizFrame>
											</VBox>
										</VBox>
									</VBox>
								</IconTabFilter>

								<IconTabFilter key="top" text="Top 5 GL" icon="sap-icon://vertical-bar-chart">
									<VBox class="fcrTabContent">
										<Toolbar design="Transparent" class="fcrTableToolbar">
											<Title text="Top 5 Variance Analysis" level="H3"/>
											<ToolbarSpacer/>
											<SegmentedButton selectedKey="{ui>/topViewMode}">
												<items>
													<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://detail-view"/>
													<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://vertical-bar-chart"/>
												</items>
											</SegmentedButton>
										</Toolbar>

										<table:Table rows="{fcr>/topDetailRows}" visible="{= ${ui>/topViewMode} === 'DETAIL' }" visibleRowCount="5" selectionMode="None" enableColumnReordering="true" class="fcrUiTable">
											<table:columns>
												<table:Column width="7rem" sortProperty="fiscalYear" hAlign="Center">
													<table:label><Label text="Fiscal Year"/></table:label>
													<table:template><Text text="{fcr>fiscalYear}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="monthText">
													<table:label><Label text="Month"/></table:label>
													<table:template><Text text="{fcr>monthText}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="glGroup">
													<table:label><Label text="GL Group"/></table:label>
													<table:template><ObjectStatus text="{fcr>glGroup}" state="Information"/></table:template>
												</table:Column>
												<table:Column width="7rem" sortProperty="glAccount">
													<table:label><Label text="GL Account"/></table:label>
													<table:template><Text text="{fcr>glAccount}"/></table:template>
												</table:Column>
												<table:Column width="12rem" sortProperty="glName">
													<table:label><Label text="GL Description"/></table:label>
													<table:template><Text text="{fcr>glName}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="profitCenter">
													<table:label><Label text="Profit Centre"/></table:label>
													<table:template><Text text="{fcr>profitCenter}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="actual" hAlign="End">
													<table:label><Label text="Actual"/></table:label>
													<table:template><ObjectNumber number="{fcr>actualText}"/></table:template>
												</table:Column>
												<table:Column width="8rem" sortProperty="variance" hAlign="End">
													<table:label><Label text="Variance"/></table:label>
													<table:template><ObjectNumber number="{fcr>varianceText}" state="{fcr>varianceState}"/></table:template>
												</table:Column>
											</table:columns>
										</table:Table>

										<VBox visible="{= ${ui>/topViewMode} === 'SUMMARY' }" class="fcrSummaryWrap">
											<table:Table rows="{fcr>/topSummaryRows}" visibleRowCount="5" selectionMode="None" enableColumnReordering="true" class="fcrUiTable">
												<table:columns>
													<table:Column width="7rem" sortProperty="fiscalYear" hAlign="Center">
														<table:label><Label text="Fiscal Year"/></table:label>
														<table:template><Text text="{fcr>fiscalYear}"/></table:template>
													</table:Column>
													<table:Column width="8rem" sortProperty="monthText">
														<table:label><Label text="Month"/></table:label>
														<table:template><Text text="{fcr>monthText}"/></table:template>
													</table:Column>
													<table:Column width="8rem" sortProperty="glGroup">
														<table:label><Label text="GL Group"/></table:label>
														<table:template><ObjectStatus text="{fcr>glGroup}" state="Information"/></table:template>
													</table:Column>
													<table:Column width="15rem" sortProperty="groupName">
														<table:label><Label text="Group Description"/></table:label>
														<table:template><Text text="{fcr>groupName}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="variance" hAlign="End">
														<table:label><Label text="Variance"/></table:label>
														<table:template><ObjectNumber number="{fcr>varianceText}" state="{fcr>varianceState}"/></table:template>
													</table:Column>
												</table:columns>
											</table:Table>

											<Toolbar design="Transparent">
												<Title text="Top 5 Summary by GL Group, Fiscal Year and Month" level="H4"/>
												<ToolbarSpacer/>
												<ObjectStatus text="Variance" state="Information"/>
											</Toolbar>
											<VBox class="fcrChartPanel fcrFullChart">
											<viz:VizFrame id="topSummaryChart" width="100%" height="360px" vizType="column">
												<viz:dataset>
													<viz.data:FlattenedDataset data="{fcr>/topSummaryChart}">
														<viz.data:dimensions>
															<viz.data:DimensionDefinition name="GL Group / FY / Month" value="{fcr>name}"/>
														</viz.data:dimensions>
														<viz.data:measures>
															<viz.data:MeasureDefinition name="Variance" value="{fcr>variance}"/>
														</viz.data:measures>
													</viz.data:FlattenedDataset>
												</viz:dataset>
												<viz:feeds>
													<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Variance"/>
													<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="GL Group / FY / Month"/>
												</viz:feeds>
											</viz:VizFrame>
											</VBox>
										</VBox>
									</VBox>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</VBox>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>
