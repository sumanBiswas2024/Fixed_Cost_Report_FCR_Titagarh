															<table:label><Label text="Oct"/></table:label>
															<table:template><ObjectNumber number="{fcr>p7Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p8" hAlign="End" visible="{ui>/p8Visible}">
															<table:label><Label text="Nov"/></table:label>
															<table:template><ObjectNumber number="{fcr>p8Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p9" hAlign="End" visible="{ui>/p9Visible}">
															<table:label><Label text="Dec"/></table:label>
															<table:template><ObjectNumber number="{fcr>p9Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p10" hAlign="End" visible="{ui>/p10Visible}">
															<table:label><Label text="Jan"/></table:label>
															<table:template><ObjectNumber number="{fcr>p10Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p11" hAlign="End" visible="{ui>/p11Visible}">
															<table:label><Label text="Feb"/></table:label>
															<table:template><ObjectNumber number="{fcr>p11Text}"/></table:template>
