											</content>
										</Panel>
										<Panel headerText="Summary Output" expandable="false" expanded="true" class="fcrOutPanel" visible="{= ${ui>/topViewMode} === 'SUMMARY' }">
											<content>
												<VBox class="fcrSummaryWrap">
													<Panel headerText="Summary Table" expandable="true" expanded="true" class="fcrSubPanel">
														<content>
															<table:Table id="topSummaryTable" rows="{fcr>/topSummaryRows}" visibleRowCount="6" selectionMode="None" enableColumnReordering="true"
																enableCellFilter="true" class="fcrUiTable">
																<table:columns>
																	<table:Column width="10rem" sortProperty="glGroup" filterProperty="glGroup">
