												</items>
											</SegmentedButton>
										</Toolbar>
										<Panel headerText="Details Output" expandable="true" expanded="true" class="fcrOutPanel" visible="{= ${ui>/topViewMode} === 'DETAIL' }">
											<content>
												<table:Table id="topDetailTable" rows="{fcr>/topDetailRows}" visibleRowCount="8" selectionMode="None" enableColumnReordering="true"
