<mvc:View controllerName="Z_Fixed_Cost_Report_FCR.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:table="sap.ui.table" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns="sap.m" displayBlock="true">
	<App class="fcrApp">
		<pages>
			<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
				<content>
					<VBox class="fcrPage">
						<!-- ===================================================== -->
						<!-- HEADER -->
						<!-- ===================================================== -->
						<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
							<VBox class="fcrHeaderText">
								<ObjectStatus text="ZFI_FCR" state="Information" icon="sap-icon://business-objects-experience" class="fcrEyebrow"/>
								<Title text="Fixed Cost Report" level="H1" class="fcrTitle"/>
								<Text text="{ui>/periodText}" class="fcrSubtitle"/>
							</VBox>
							<ObjectStatus text="{ui>/lastRunText}" state="Success" icon="sap-icon://sys-enter-2" class="fcrRunStatus"/>
						</HBox>
						<!-- ===================================================== -->
						<!-- PARAMETERS -->
						<!-- ===================================================== -->
						<VBox class="fcrParamWrap">
							<HBox class="fcrParamHeader" alignItems="Center" justifyContent="SpaceBetween">
								<Title text="Report Parameters" level="H4"/>
								<Button id="paramToggleBtn" class="fcrParamToggle" type="Transparent" press=".onToggleParams"
									icon="{= ${ui>/paramsExpanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }"
									tooltip="{= ${ui>/paramsExpanded} ? 'Collapse parameters' : 'Expand parameters' }"/>
							</HBox>
							<VBox id="paramGrid" visible="{ui>/paramsExpanded}" class="fcrParamGrid">
								<HBox class="fcrParamRow" alignItems="End" justifyContent="Start" wrap="Wrap">
									<!-- Company Code -->
									<VBox class="fcrField fcrFieldCc">
										<Label text="Company Code" required="true"/>
										<Input value="{filters>/companyCode}" maxLength="4" placeholder="1000"/>
									</VBox>
									<!-- Fiscal Year -->
									<VBox class="fcrField fcrFieldFy">
										<Label text="Fiscal Year" required="true"/>
										<DatePicker value="{filters>/fiscalYear}" valueFormat="yyyy" displayFormat="yyyy" placeholder="YYYY" change=".onFiscalYearChange"/>
									</VBox>
									<!-- Quarter -->
									<VBox class="fcrField fcrFieldQtr">
										<Label text="Quarter"/>
										<Select selectedKey="{filters>/quarter}" width="100%" change=".onQuarterChange" items="{lookups>/quarters}">
											<core:Item key="{lookups>key}" text="{lookups>text}"/>
										</Select>
									</VBox>
									<!-- Profit Centre -->
									<VBox class="fcrField fcrFieldPc">
										<Label text="Profit Centre"/>
										<MultiInput id="profitCentreInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onProfitCentreValueHelp"
											tokens="{filters>/profitCenters}" placeholder="Choose profit centres">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<!-- GL Group -->
									<VBox class="fcrField fcrFieldGlg">
										<Label text="GL Group"/>
										<MultiInput id="glGroupInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlGroupValueHelp" tokens="{filters>/glGroups}"
											placeholder="Choose GL groups">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<!-- ACTIONS -->
									<VBox class="fcrField fcrFieldAct">
										<Label text=" "/>
										<HBox class="fcrActionRow" alignItems="Center">
											<Button icon="sap-icon://refresh" tooltip="Reset Filters" press=".onReset" type="Default"/>
											<Button text="Run Report" icon="sap-icon://play" type="Emphasized" press=".onSearch"/>
										</HBox>
									</VBox>
								</HBox>
							</VBox>
						</VBox>
						<!-- ===================================================== -->
						<!-- KPI SECTION -->
						<!-- ===================================================== -->
						<layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="fcrKpiGrid">
							<VBox class="fcrKpi fcrKpiA">
								<Text text="Actual Fixed Cost"/>
								<ObjectNumber number="{ui>/totalActual}" unit="INR" state="Information"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiB">
								<Text text="Budget"/>
								<ObjectNumber number="{ui>/totalBudget}" unit="INR"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiV">
								<Text text="Variance"/>
								<ObjectNumber number="{ui>/totalVariance}" unit="INR" state="{ui>/varianceState}"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiP">
								<Text text="Variance %"/>
								<ObjectNumber number="{ui>/variancePct}" unit="%" state="{ui>/varianceState}"/>
							</VBox>
						</layout:Grid>
						<!-- ===================================================== -->
						<!-- TABS -->
						<!-- ===================================================== -->
						<IconTabBar selectedKey="{ui>/selectedTab}" class="fcrTabs" expandable="false">
							<items>
								<!-- ================================================= -->
								<!-- ALL TAB -->
								<!-- ================================================= -->
								<IconTabFilter key="all" text="All" icon="sap-icon://table-view">
									<VBox class="fcrTabContent">
										<Toolbar design="Transparent" class="fcrTableToolbar">
											<Title text="All Fixed Cost Lines" level="H3"/>
											<ToolbarSpacer/>
											<SegmentedButton selectedKey="{ui>/allViewMode}">
												<items>
													<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://detail-view"/>
													<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://vertical-bar-chart"/>
												</items>
											</SegmentedButton>
										</Toolbar>
										<!-- DETAIL TABLE -->
										<table:Table rows="{fcr>/allDetailRows}" visible="{= ${ui>/allViewMode} === 'DETAIL' }" visibleRowCount="9" selectionMode="None"
											enableColumnReordering="true" class="fcrUiTable">
											<table:columns>
												<table:Column width="7rem">
													<table:label>
														<Label text="Fiscal Year"/>
													</table:label>
													<table:template>
														<Text text="{fcr>fiscalYear}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem">
													<table:label>
														<Label text="Month"/>
													</table:label>
													<table:template>
														<Text text="{fcr>monthText}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem">
													<table:label>
														<Label text="GL Group"/>
													</table:label>
													<table:template>
														<ObjectStatus text="{fcr>glGroup}" state="Information"/>
													</table:template>
												</table:Column>
												<table:Column width="7rem">
													<table:label>
														<Label text="GL Account"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glAccount}"/>
													</table:template>
												</table:Column>
												<table:Column width="12rem">
													<table:label>
														<Label text="GL Description"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glName}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem">
													<table:label>
														<Label text="Profit Centre"/>
													</table:label>
													<table:template>
														<Text text="{fcr>profitCenter}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem" hAlign="End">
													<table:label>
														<Label text="Budget"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>budgetText}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem" hAlign="End">
													<table:label>
														<Label text="Actual"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>actualText}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem" hAlign="End">
													<table:label>
														<Label text="Variance"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>varianceText}" state="{fcr>varianceState}"/>
													</table:template>
												</table:Column>
											</table:columns>
										</table:Table>
									</VBox>
								</IconTabFilter>
								<!-- ================================================= -->
								<!-- TOP 5 TAB -->
								<!-- ================================================= -->
								<IconTabFilter key="top" text="Top 5 GL" icon="sap-icon://vertical-bar-chart">
									<VBox class="fcrTabContent">
										<Toolbar design="Transparent" class="fcrTableToolbar">
											<Title text="Top 5 Variance Analysis" level="H3"/>
											<ToolbarSpacer/>
											<SegmentedButton selectedKey="{ui>/topViewMode}">
												<items>
													<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://detail-view"/>
													<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://vertical-bar-chart"/>
												</items>
											</SegmentedButton>
										</Toolbar>
										<table:Table rows="{fcr>/topDetailRows}" visible="{= ${ui>/topViewMode} === 'DETAIL' }" visibleRowCount="5" selectionMode="None"
											enableColumnReordering="true" class="fcrUiTable">
											<table:columns>
												<table:Column width="7rem">
													<table:label>
														<Label text="Fiscal Year"/>
													</table:label>
													<table:template>
														<Text text="{fcr>fiscalYear}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem">
													<table:label>
														<Label text="Month"/>
													</table:label>
													<table:template>
														<Text text="{fcr>monthText}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem">
													<table:label>
														<Label text="GL Group"/>
													</table:label>
													<table:template>
														<ObjectStatus text="{fcr>glGroup}" state="Information"/>
													</table:template>
												</table:Column>
												<table:Column width="7rem">
													<table:label>
														<Label text="GL Account"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glAccount}"/>
													</table:template>
												</table:Column>
												<table:Column width="12rem">
													<table:label>
														<Label text="GL Description"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glName}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem">
													<table:label>
														<Label text="Profit Centre"/>
													</table:label>
													<table:template>
														<Text text="{fcr>profitCenter}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem" hAlign="End">
													<table:label>
														<Label text="Actual"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>actualText}"/>
													</table:template>
												</table:Column>
												<table:Column width="8rem" hAlign="End">
													<table:label>
														<Label text="Variance"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>varianceText}" state="{fcr>varianceState}"/>
													</table:template>
												</table:Column>
											</table:columns>
										</table:Table>
									</VBox>
								</IconTabFilter>
							</items>
						</IconTabBar>
					</VBox>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>