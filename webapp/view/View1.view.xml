																	<table:Column width="9rem" sortProperty="p2" hAlign="End" visible="{ui>/p2Visible}">
																		<table:label><Label text="May"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p2Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p3" hAlign="End" visible="{ui>/p3Visible}">
																		<table:label><Label text="Jun"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p3Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p4" hAlign="End" visible="{ui>/p4Visible}">
																		<table:label><Label text="Jul"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p4Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p5" hAlign="End" visible="{ui>/p5Visible}">
																		<table:label><Label text="Aug"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p5Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p6" hAlign="End" visible="{ui>/p6Visible}">
																		<table:label><Label text="Sep"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p6Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p7" hAlign="End" visible="{ui>/p7Visible}">
																		<table:label><Label text="Oct"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p7Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p8" hAlign="End" visible="{ui>/p8Visible}">
																		<table:label><Label text="Nov"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p8Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p9" hAlign="End" visible="{ui>/p9Visible}">
																		<table:label><Label text="Dec"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p9Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p10" hAlign="End" visible="{ui>/p10Visible}">
																		<table:label><Label text="Jan"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p10Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p11" hAlign="End" visible="{ui>/p11Visible}">
																		<table:label><Label text="Feb"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p11Text}"/></table:template>
																	</table:Column>
																	<table:Column width="9rem" sortProperty="p12" hAlign="End" visible="{ui>/p12Visible}">
																		<table:label><Label text="Mar"/></table:label>
																		<table:template><ObjectNumber number="{fcr>p12Text}"/></table:template>
																	</table:Column>
																</table:columns>
															</table:Table>
														</content>
													</Panel>
													<Panel headerText="Chart" expandable="true" expanded="true" class="fcrSubPanel">
														<content>
															<Toolbar design="Transparent">
																<Title text="GL Account Total" level="H4"/>
																<ToolbarSpacer/>
																<ObjectStatus text="Total" state="Information"/>
															</Toolbar>
															<VBox class="fcrChartPanel fcrFullChart">
																<viz:VizFrame id="allSummaryChart" width="100%" height="360px" vizType="column">
																	<viz:dataset>
																		<viz.data:FlattenedDataset data="{fcr>/allSummaryChart}">
																			<viz.data:dimensions>
																				<viz.data:DimensionDefinition name="GL Account" value="{fcr>name}"/>
																			</viz.data:dimensions>
																			<viz.data:measures>
																				<viz.data:MeasureDefinition name="Total" value="{fcr>value}"/>
																			</viz.data:measures>
																		</viz.data:FlattenedDataset>
																	</viz:dataset>
																	<viz:feeds>
																		<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Total"/>
																		<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="GL Account"/>
																	</viz:feeds>
																</viz:VizFrame>
															</VBox>
														</content>
													</Panel>
												</VBox>
											</content>
										</Panel>
									</VBox>
								</IconTabFilter>
								<IconTabFilter key="top" text="Top 5 GL" icon="sap-icon://vertical-bar-chart">
									<VBox class="fcrTabContent">
										<Toolbar design="Transparent" class="fcrTableToolbar">
											<Title text="Top 5 GL (by Total)" level="H3"/>
											<ToolbarSpacer/>
											<SearchField width="22rem" placeholder="Search (GL, text, group, year...)" liveChange=".onTopSearch" value="{ui>/topSearch}"
												class="fcrToolbarSearch"/>
											<Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onExport" class="fcrToolbarExport"/>
											<SegmentedButton selectedKey="{ui>/topViewMode}" selectionChange=".onViewModeChange">
												<items>
													<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://detail-view"/>
