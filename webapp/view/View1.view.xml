<mvc:View controllerName="Z_Fixed_Cost_Report_FCR.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:table="sap.ui.table" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:suite="sap.suite.ui.commons" xmlns="sap.m" displayBlock="true">
	<App class="fcrApp">
		<pages>
			<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
				<content>
					<!-- =====================================================
     REPORT PARAMETERS
===================================================== -->
					<VBox id="paramSection" class="fcrParamWrap">
						<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
							<VBox class="fcrHeaderText">
								<!--<ObjectStatus text="ZFI_FCR" state="Information" icon="sap-icon://business-objects-experience" class="fcrEyebrow"/>-->
								<Title text="Fixed Cost Report" level="H1" class="fcrTitle"/>
								<Text text="{ui>/periodText}" class="fcrSubtitle"/>
							</VBox>
							<ObjectStatus text="{ui>/lastRunText}" state="Success" icon="sap-icon://sys-enter-2" class="fcrRunStatus"/>
						</HBox>
						<VBox class="fcrParamWrap">
							<HBox class="fcrParamHeader" alignItems="Center" justifyContent="SpaceBetween">
								<Title text="Report Parameters" level="H4"/>
								<Button id="paramToggleBtn" class="fcrParamToggle" type="Transparent" press=".onToggleParams"
									icon="{= ${ui>/paramsExpanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }"
									tooltip="{= ${ui>/paramsExpanded} ? 'Collapse parameters' : 'Expand parameters' }"/>
							</HBox>
							<VBox id="paramGrid" visible="{ui>/paramsExpanded}" class="fcrParamGrid">
								<HBox class="fcrParamRow" alignItems="End" justifyContent="Start" wrap="NoWrap">
									<!--<VBox class="fcrField fcrFieldCc">-->
									<!--	<Label text="Company Code" required="true"/>-->
									<!--	<Input value="{filters>/companyCode}" maxLength="4" placeholder="Select CC" valueState="{ui>/companyCodeState}" showValueHelp="true"-->
									<!--		valueHelpOnly="false" valueHelpRequest=".onCompanyCodeValueHelp"/>-->
									<!--</VBox>-->
									<VBox class="fcrField fcrFieldCc">
										<Label text="Company Code" required="true"/>
										<ComboBox id="ccComboBox" selectedKey="{filters>/companyCode}" placeholder="Select Company Code" valueState="{ui>/companyCodeState}"
											width="100%">
											<core:Item key="1100" text="1100"/>
											<core:Item key="1600" text="1600"/>
										</ComboBox>
									</VBox>
									<VBox class="fcrField fcrFieldFy">
										<Label text="Fiscal Year" required="true"/>
										<!--<DatePicker value="{filters>/fiscalYear}" valueFormat="yyyy" displayFormat="yyyy" change=".onFiscalYearChange"-->
										<!--	valueState="{ui>/fiscalYearState}"/>-->
										<ComboBox selectedKey="{filters>/fiscalYear}" items="{yearModel>/years}" change=".onFiscalYearChange" valueState="{ui>/fiscalYearState}"
											placeholder="Select FY">
											<core:Item key="{yearModel>key}" text="{yearModel>text}"/>
										</ComboBox>
									</VBox>
									<VBox class="fcrField fcrFieldQtr">
										<Label text="Quarter" required="false"/>
										<MultiInput id="quarterInput" value="{path: 'filters>/quarters', formatter: '.formatTokenKeys'}" showValueHelp="true" valueHelpOnly="true"
											tokenUpdate=".onTokenUpdate" valueHelpRequest=".onQuarterValueHelp" placeholder="Select Quarters"/>
									</VBox>
									<VBox class="fcrField fcrFieldPc">
										<Label text="Profit Centre"/>
										<MultiInput id="profitCentreInput" value="{path: 'filters>/profitCenters', formatter: '.formatTokenKeys'}" showValueHelp="true"
											valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onProfitCentreValueHelp" placeholder="Select PC"/>
									</VBox>
									<VBox class="fcrField fcrFieldGlg">
										<Label text="GL Group"/>
										<MultiInput id="glGroupInput" value="{path: 'filters>/glGroups', formatter: '.formatTokenKeys'}" showValueHelp="true" valueHelpOnly="true"
											tokenUpdate=".onTokenUpdate" valueHelpRequest=".onGlGroupValueHelp" placeholder="Select GL"/>
									</VBox>
									<HBox class="fcrActionsContainer" alignItems="Center">
										<Button icon="sap-icon://reset" tooltip="Reset" press=".onReset" class="fcrBtnReset"/>
										<Button text="Run Report" icon="sap-icon://play" type="Emphasized" press=".onSearch" class="fcrBtnRun"/>
									</HBox>
								</HBox>
							</VBox>
						</VBox>
					</VBox>
					<!-- =====================================================
     STICKY KPI + TABS SECTION
===================================================== -->
					<!--<VBox class="fcrStickySection">-->
					<VBox class="">
						<!-- KPI CARDS -->
						<!--<HBox class="fcrKpiStickyWrap" wrap="Wrap">-->
						<layout:Grid defaultSpan="XL4 L4 M4 S12" hSpacing="1" vSpacing="1" class="fcrKpiGrid">
							<VBox class="fcrKpi fcrKpiA">
								<Text text="Actual Fixed Cost"/>
								<ObjectNumber number="{ui>/totalActual}" unit="INR" state="Information"/>
							</VBox>
							<!--<VBox class="fcrKpi fcrKpiB">-->
							<!--	<Text text="Budget (not bound)"/>-->
							<!--	<ObjectNumber number="{ui>/totalBudget}" unit="INR"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrKpi fcrKpiB">-->
							<!--	<Text text="Max GL Group"/>-->
							<!--	<Text text="{ui>/maxGlGroupName}" class="fcrKpiSubText"/>-->
							<!--</VBox>-->
							<VBox class="fcrKpi fcrKpiB">
								<Text text="Max GL Total"/>
								<!--<ObjectNumber number="{ui>/totalVariance}" unit="INR" state="{ui>/varianceState}"/>-->
								<ObjectNumber number="{ui>/totalVariance}" unit="INR"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiP">
								<Text text="Records"/>
								<ObjectNumber number="{ui>/recordCount}"/>
							</VBox>
						</layout:Grid>
						<!--</HBox>-->
						<!-- SEGMENT TOOLBAR -->
						<HBox justifyContent="SpaceBetween" alignItems="End" class="fcrSegmentToolbar">
							<HBox alignItems="End" class="fcrSegmentLeft">
								<!--<VBox class="fcrModeBlock">-->
								<!--	<Label text="View Type"/>-->
								<!--	<SegmentedButton selectedKey="{= ${ui>/selectedTab} === 'all' ? ${ui>/allViewMode} : ${ui>/topViewMode} }"-->
								<!--		selectionChange="onViewModeChange" class="fcrViewSwitch">-->
								<!--		<items>-->
								<!--			<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://table-view"/>-->
								<!--			<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://business-objects-experience"/>-->
								<!--		</items>-->
								<!--	</SegmentedButton>-->
								<!--</VBox>-->
								<VBox class="fcrModeBlock">
									<Label text="Report Type"/>
									<SegmentedButton selectedKey="{ui>/selectedTab}" selectionChange="onSegmentTabChange" class="fcrViewSwitch">
										<items>
											<SegmentedButtonItem key="all" text="All GL" icon="sap-icon://detail-view"/>
											<SegmentedButtonItem key="top" text="Top 5 GL" icon="sap-icon://vertical-bar-chart"/>
										</items>
									</SegmentedButton>
								</VBox>
								<VBox class="fcrModeBlock">
									<Label text="View"/>
									<SegmentedButton selectedKey="{= ${ui>/selectedTab} === 'all' ? ${ui>/allViewMode} : ${ui>/topViewMode} }"
										selectionChange="onViewModeChange" class="fcrViewSwitch">
										<items>
											<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://table-view"/>
											<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://business-objects-experience"/>
										</items>
									</SegmentedButton>
								</VBox>
							</HBox>
							<HBox alignItems="End">
								<SearchField width="18rem" placeholder="Search..." liveChange="onUniversalSearch" class="fcrToolbarSearch"/>
								<Button icon="sap-icon://excel-attachment" tooltip="Export" class="fcrToolbarExport sapUiTinyMarginBegin" press="onExport"/>
							</HBox>
						</HBox>
					</VBox>
					<!-- =====================================================
     SCROLL CONTENT
===================================================== -->
					<VBox class="fcrContentSection">
						<!-- ALL DETAILS -->
						<VBox visible="{= ${ui>/selectedTab} === 'all' }">
							<!-- DETAIL TABLE -->
							<VBox visible="{= ${ui>/allViewMode} === 'DETAIL' }">
								<Panel headerText="All Details" expandable="false" expanded="true" class="fcrOutPanel" visible="{= ${ui>/allViewMode} === 'DETAIL' }">
									<content>
										<table:Table id="allDetailTable" rows="{fcr>/allDetailRows}" visibleRowCount="12" selectionMode="None" enableColumnReordering="true"
											enableCellFilter="true" class="fcrUiTable">
											<table:columns>
												<table:Column width="7rem" sortProperty="glAccount" filterProperty="glAccount">
													<table:label>
														<Label text="G/L Acct"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glAccount}"/>
													</table:template>
												</table:Column>
												<table:Column width="14rem" sortProperty="glName" filterProperty="glName">
													<table:label>
														<Label text="G/L Acct Long Text"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glName}"/>
													</table:template>
												</table:Column>
												<table:Column width="18rem" sortProperty="glGroupText" filterProperty="glGroupText">
													<table:label>
														<Label text="G/L Group"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glGroupText}"/>
													</table:template>
												</table:Column>
												<table:Column width="10rem" sortProperty="total" hAlign="End">
													<table:label>
														<Label text="Total"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>totalText}" state="{fcr>totalState}"/>
													</table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p1Visible}" hAlign="End">
													<table:label><Label text="Apr"/></table:label>
													<table:template><ObjectNumber number="{fcr>p1Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p2Visible}" hAlign="End">
													<table:label><Label text="May"/></table:label>
													<table:template><ObjectNumber number="{fcr>p2Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p3Visible}" hAlign="End">
													<table:label><Label text="Jun"/></table:label>
													<table:template><ObjectNumber number="{fcr>p3Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p4Visible}" hAlign="End">
													<table:label><Label text="Jul"/></table:label>
													<table:template><ObjectNumber number="{fcr>p4Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p5Visible}" hAlign="End">
													<table:label><Label text="Aug"/></table:label>
													<table:template><ObjectNumber number="{fcr>p5Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p6Visible}" hAlign="End">
													<table:label><Label text="Sep"/></table:label>
													<table:template><ObjectNumber number="{fcr>p6Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p7Visible}" hAlign="End">
													<table:label><Label text="Oct"/></table:label>
													<table:template><ObjectNumber number="{fcr>p7Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p8Visible}" hAlign="End">
													<table:label><Label text="Nov"/></table:label>
													<table:template><ObjectNumber number="{fcr>p8Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p9Visible}" hAlign="End">
													<table:label><Label text="Dec"/></table:label>
													<table:template><ObjectNumber number="{fcr>p9Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p10Visible}" hAlign="End">
													<table:label><Label text="Jan"/></table:label>
													<table:template><ObjectNumber number="{fcr>p10Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p11Visible}" hAlign="End">
													<table:label><Label text="Feb"/></table:label>
													<table:template><ObjectNumber number="{fcr>p11Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/p12Visible}" hAlign="End">
													<table:label><Label text="Mar"/></table:label>
													<table:template><ObjectNumber number="{fcr>p12Text}"/></table:template>
												</table:Column>
												<!--Quarter-->
												<table:Column width="9rem" visible="{ui>/q1Visible}" hAlign="End">
													<table:label><Label text="Q1"/></table:label>
													<table:template><ObjectNumber number="{fcr>q1Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/q2Visible}" hAlign="End">
													<table:label><Label text="Q2"/></table:label>
													<table:template><ObjectNumber number="{fcr>q2Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/q3Visible}" hAlign="End">
													<table:label><Label text="Q3"/></table:label>
													<table:template><ObjectNumber number="{fcr>q3Text}"/></table:template>
												</table:Column>
												<table:Column width="9rem" visible="{ui>/q4Visible}" hAlign="End">
													<table:label><Label text="Q4"/></table:label>
													<table:template><ObjectNumber number="{fcr>q4Text}"/></table:template>
												</table:Column>
											</table:columns>
										</table:Table>
									</content>
								</Panel>
							</VBox>
							<!-- SUMMARY TABLE -->
							<VBox visible="{= ${ui>/allViewMode} === 'SUMMARY' }">
								<Panel headerText="" expandable="false" expanded="true" class="fcrOutPanel" visible="{= ${ui>/allViewMode} === 'SUMMARY' }">
									<content>
										<suite:ChartContainer id="allSummaryChartContainer" showFullScreen="true" showPersonalization="false" autoAdjustHeight="false"
											showLegendButton="false" title="All Fixed Cost Summary" class="fcrChartContainer">
											<suite:content>
												<!-- ========================================================= -->
												<!-- TABLE VIEW -->
												<!-- ========================================================= -->
												<suite:ChartContainerContent icon="sap-icon://table-chart" title="Table View">
													<suite:content>
														<table:Table id="allSummaryTable" rows="{fcr>/allSummaryRows}" visibleRowCount="8" selectionMode="None" enableColumnReordering="true"
															enableCellFilter="true" class="fcrUiTable">
															<table:columns>
																<table:Column width="10rem" sortProperty="glGroup" filterProperty="glGroup">
																	<table:label>
																		<Label text="G/L Group"/>
																	</table:label>
																	<table:template>
																		<Text text="{fcr>glGroup}"/>
																	</table:template>
																</table:Column>
																<!--<table:Column width="20rem" sortProperty="groupName" filterProperty="groupName">-->
																<!--	<table:label>-->
																<!--		<Label text="G/L Group Text"/>-->
																<!--	</table:label>-->
																<!--	<table:template>-->
																<!--		<Text text="{fcr>groupName}"/>-->
																<!--	</table:template>-->
																<!--</table:Column>-->
																<table:Column width="10rem" sortProperty="total" hAlign="End">
																	<table:label>
																		<Label text="Total"/>
																	</table:label>
																	<table:template>
																		<ObjectNumber number="{fcr>totalText}" state="{fcr>totalState}"/>
																	</table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p1Visible}" hAlign="End">
																	<table:label><Label text="Apr"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p1Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p2Visible}" hAlign="End">
																	<table:label><Label text="May"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p2Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p3Visible}" hAlign="End">
																	<table:label><Label text="Jun"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p3Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p4Visible}" hAlign="End">
																	<table:label><Label text="Jul"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p4Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p5Visible}" hAlign="End">
																	<table:label><Label text="Aug"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p5Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p6Visible}" hAlign="End">
																	<table:label><Label text="Sep"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p6Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p7Visible}" hAlign="End">
																	<table:label><Label text="Oct"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p7Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p8Visible}" hAlign="End">
																	<table:label><Label text="Nov"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p8Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p9Visible}" hAlign="End">
																	<table:label><Label text="Dec"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p9Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p10Visible}" hAlign="End">
																	<table:label><Label text="Jan"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p10Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p11Visible}" hAlign="End">
																	<table:label><Label text="Feb"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p11Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/p12Visible}" hAlign="End">
																	<table:label><Label text="Mar"/></table:label>
																	<table:template><ObjectNumber number="{fcr>p12Text}"/></table:template>
																</table:Column>
																<!--Quarter-->
																<table:Column width="9rem" visible="{ui>/q1Visible}" hAlign="End">
																	<table:label><Label text="Q1"/></table:label>
																	<table:template><ObjectNumber number="{fcr>q1Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/q2Visible}" hAlign="End">
																	<table:label><Label text="Q2"/></table:label>
																	<table:template><ObjectNumber number="{fcr>q2Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/q3Visible}" hAlign="End">
																	<table:label><Label text="Q3"/></table:label>
																	<table:template><ObjectNumber number="{fcr>q3Text}"/></table:template>
																</table:Column>
																<table:Column width="9rem" visible="{ui>/q4Visible}" hAlign="End">
																	<table:label><Label text="Q4"/></table:label>
																	<table:template><ObjectNumber number="{fcr>q4Text}"/></table:template>
																</table:Column>
															</table:columns>
														</table:Table>
													</suite:content>
												</suite:ChartContainerContent>
												<!-- ========================================================= -->
												<!-- CHART VIEW -->
												<!-- ========================================================= -->
												<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Total Chart View">
													<suite:content>
														<viz:VizFrame id="allSummaryChart" width="100%" height="420px" vizType="column" uiConfig="{applicationSet:'fiori'}">
															<viz:dependents>
																<viz:Popover id="allSummaryPopover"/>
															</viz:dependents>
															<viz:dataset>
																<viz.data:FlattenedDataset data="{fcr>/allSummaryChart}">
																	<viz.data:dimensions>
																		<viz.data:DimensionDefinition name="GL Account" value="{fcr>name}"/>
																	</viz.data:dimensions>
																	<viz.data:measures>
																		<viz.data:MeasureDefinition name="Total" value="{fcr>value}"/>
																	</viz.data:measures>
																</viz.data:FlattenedDataset>
															</viz:dataset>
															<viz:feeds>
																<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Total"/>
																<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="GL Account"/>
															</viz:feeds>
														</viz:VizFrame>
													</suite:content>
												</suite:ChartContainerContent>
												<!--All Trend Chart-->
												<suite:ChartContainerContent icon="sap-icon://line-chart" title="Period Chart View">
													<suite:content>
														<viz:VizFrame id="allTrendChart" width="100%" height="420px" vizType="column" uiConfig="{applicationSet:'fiori'}">
															<viz:dependents>
																<viz:Popover id="allTrendPopover"/>
															</viz:dependents>
															<viz:dataset>
																<viz.data:FlattenedDataset data="{fcr>/allTrendChart}">
																	<viz.data:dimensions>
																		<viz.data:DimensionDefinition name="Period" value="{fcr>period}"/>
																		<viz.data:DimensionDefinition name="GL Group" value="{fcr>gl}"/>
																	</viz.data:dimensions>
																	<viz.data:measures>
																		<viz.data:MeasureDefinition name="Amount" value="{fcr>value}"/>
																	</viz.data:measures>
																</viz.data:FlattenedDataset>
															</viz:dataset>
															<viz:feeds>
																<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Amount"/>
																<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="GL Group"/>
																<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Period"/>
																<!--<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="GL Group"/>-->
															</viz:feeds>
														</viz:VizFrame>
													</suite:content>
												</suite:ChartContainerContent>
											</suite:content>
										</suite:ChartContainer>
									</content>
								</Panel>
							</VBox>
						</VBox>
						<!-- TOP 5 -->
						<VBox visible="{= ${ui>/selectedTab} === 'top' }">
							<!-- DETAIL TABLE -->
							<VBox visible="{= ${ui>/topViewMode} === 'DETAIL' }">
								<Panel headerText="Top 4 Details" expandable="false" expanded="true" class="fcrOutPanel" visible="{= ${ui>/topViewMode} === 'DETAIL' }">
									<content>
										<table:Table id="topDetailTable" rows="{fcr>/topDetailRows}" visibleRowCount="8" selectionMode="None" enableColumnReordering="true"
											enableCellFilter="true" class="fcrUiTable">
											<table:columns>
