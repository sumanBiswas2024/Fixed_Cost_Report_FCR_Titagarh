<mvc:View controllerName="Z_Fixed_Cost_Report_FCR.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:table="sap.ui.table" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns="sap.m" displayBlock="true">
	<App class="fcrApp">
		<pages>
			<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
				<content>
					<VBox class="fcrPage">
						<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
							<VBox class="fcrHeaderText">
								<ObjectStatus text="ZFI_FCR" state="Information" icon="sap-icon://business-objects-experience" class="fcrEyebrow"/>
								<Title text="Fixed Cost Report" level="H1" class="fcrTitle"/>
								<Text text="{ui>/periodText}" class="fcrSubtitle"/>
							</VBox>
							<ObjectStatus text="{ui>/lastRunText}" state="Success" icon="sap-icon://sys-enter-2" class="fcrRunStatus"/>
						</HBox>
						<VBox class="fcrParamWrap">
							<HBox class="fcrParamHeader" alignItems="Center" justifyContent="SpaceBetween">
								<Title text="Report Parameters" level="H4"/>
								<Button id="paramToggleBtn" class="fcrParamToggle" type="Transparent" press=".onToggleParams"
									icon="{= ${ui>/paramsExpanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-down' }"
									tooltip="{= ${ui>/paramsExpanded} ? 'Collapse parameters' : 'Expand parameters' }"/>
							</HBox>
							<VBox id="paramGrid" visible="{ui>/paramsExpanded}" class="fcrParamGrid">
								<HBox class="fcrParamRow" alignItems="End" justifyContent="Start" wrap="NoWrap">
									<VBox class="fcrField fcrFieldCc">
										<Label text="Company Code" required="true"/>
										<Input value="{filters>/companyCode}" maxLength="4" placeholder="1000" valueState="{ui>/companyCodeState}"/>
									</VBox>
									<VBox class="fcrField fcrFieldFy">
										<Label text="Fiscal Year" required="true"/>
										<DatePicker value="{filters>/fiscalYear}" valueFormat="yyyy" displayFormat="yyyy" change=".onFiscalYearChange"
											valueState="{ui>/fiscalYearState}"/>
									</VBox>
									<!--<VBox class="fcrField fcrFieldQtr">-->
									<!--	<Label text="Quarter" required="true"/>-->
									<!--	<Select selectedKey="{filters>/quarter}" width="100%" change=".onQuarterChange" items="{lookups>/quarters}">-->
									<!--		<core:Item key="{lookups>key}" text="{lookups>text}"/>-->
									<!--	</Select>-->
									<!--</VBox>-->
									<VBox class="fcrField fcrFieldQtr">
										<Label text="Quarter" required="false"/>
										<MultiInput id="quarterInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onQuarterValueHelp" tokens="{filters>/quarters}"
											placeholder="Choose quarters">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<VBox class="fcrField fcrFieldPc">
										<Label text="Profit Centre"/>
										<MultiInput id="profitCentreInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onProfitCentreValueHelp"
											tokens="{filters>/profitCenters}" placeholder="Choose PC">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<VBox class="fcrField fcrFieldGlg">
										<Label text="GL Group"/>
										<MultiInput id="glGroupInput" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlGroupValueHelp" tokens="{filters>/glGroups}"
											placeholder="Choose GL">
											<tokens>
												<Token key="{filters>key}" text="{filters>text}"/>
											</tokens>
										</MultiInput>
									</VBox>
									<HBox class="fcrActionsContainer" alignItems="Center">
										<Button icon="sap-icon://reset" tooltip="Reset" press=".onReset" class="fcrBtnReset"/>
										<Button text="Run Report" icon="sap-icon://play" type="Emphasized" press=".onSearch" class="fcrBtnRun"/>
									</HBox>
								</HBox>
							</VBox>
						</VBox>
						<layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="fcrKpiGrid">
							<VBox class="fcrKpi fcrKpiA">
								<Text text="Actual Fixed Cost"/>
								<ObjectNumber number="{ui>/totalActual}" unit="INR" state="Information"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiB">
								<Text text="Budget (not bound)"/>
								<ObjectNumber number="{ui>/totalBudget}" unit="INR"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiV">
								<Text text="Max GL Total"/>
								<ObjectNumber number="{ui>/totalVariance}" unit="INR" state="{ui>/varianceState}"/>
							</VBox>
							<VBox class="fcrKpi fcrKpiP">
								<Text text="Records"/>
								<ObjectNumber number="{ui>/recordCount}"/>
							</VBox>
						</layout:Grid>
						<IconTabBar selectedKey="{ui>/selectedTab}" class="fcrTabs" expandable="false" select=".onTabSelect">
							<items>
								<IconTabFilter key="all" text="All" icon="sap-icon://table-view">
									<VBox class="fcrTabContent">
										<Toolbar design="Transparent" class="fcrTableToolbar">
											<Title text="All Fixed Cost" level="H3"/>
											<ToolbarSpacer/>
											<SearchField width="22rem" placeholder="Search (GL, text, group, year...)" liveChange=".onAllSearch" value="{ui>/allSearch}"
												class="fcrToolbarSearch"/>
											<Button icon="sap-icon://excel-attachment" tooltip="Export" press=".onExport" class="fcrToolbarExport"/>
											<SegmentedButton selectedKey="{ui>/allViewMode}" selectionChange=".onViewModeChange">
												<items>
													<SegmentedButtonItem key="DETAIL" text="Details" icon="sap-icon://detail-view"/>
													<SegmentedButtonItem key="SUMMARY" text="Summary" icon="sap-icon://vertical-bar-chart"/>
												</items>
											</SegmentedButton>
										</Toolbar>
										<Panel headerText="Details Output" expandable="true" expanded="true" class="fcrOutPanel" visible="{= ${ui>/allViewMode} === 'DETAIL' }">
											<content>
												<table:Table id="allDetailTable" rows="{fcr>/allDetailRows}" visibleRowCount="12" selectionMode="None" enableColumnReordering="true"
													enableCellFilter="true" class="fcrUiTable">
													<table:columns>
														<table:Column width="7rem" sortProperty="glAccount" filterProperty="glAccount">
															<table:label><Label text="G/L Acct"/></table:label>
															<table:template><Text text="{fcr>glAccount}"/></table:template>
														</table:Column>
														<table:Column width="14rem" sortProperty="glName" filterProperty="glName">
															<table:label><Label text="G/L Acct Long Text"/></table:label>
															<table:template><Text text="{fcr>glName}"/></table:template>
														</table:Column>
														<table:Column width="18rem" sortProperty="glGroupText" filterProperty="glGroupText">
															<table:label><Label text="G/L Group"/></table:label>
															<table:template><Text text="{fcr>glGroupText}"/></table:template>
														</table:Column>
														<table:Column width="10rem" sortProperty="total" hAlign="End">
															<table:label><Label text="Total"/></table:label>
															<table:template><ObjectNumber number="{fcr>totalText}" state="{fcr>totalState}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p1" hAlign="End" visible="{ui>/p1Visible}">
															<table:label><Label text="Apr"/></table:label>
															<table:template><ObjectNumber number="{fcr>p1Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p2" hAlign="End" visible="{ui>/p2Visible}">
															<table:label><Label text="May"/></table:label>
															<table:template><ObjectNumber number="{fcr>p2Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p3" hAlign="End" visible="{ui>/p3Visible}">
															<table:label><Label text="Jun"/></table:label>
															<table:template><ObjectNumber number="{fcr>p3Text}"/></table:template>
														</table:Column>
														<table:Column width="9rem" sortProperty="p4" hAlign="End" visible="{ui>/p4Visible}">
															<table:label><Label text="Jul"/></table:label>
