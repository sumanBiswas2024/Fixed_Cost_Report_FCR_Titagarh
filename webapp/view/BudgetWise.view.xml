<mvc:View controllerName="Z_Fixed_Cost_Report_FCR.controller.BudgetWise" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:table="sap.ui.table" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:suite="sap.suite.ui.commons" xmlns="sap.m" displayBlock="true">
	<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
		<content>
			<VBox id="paramSection" class="fcrParamWrap">
				<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" type="Transparent" press=".onBack" tooltip="Back" class="sapUiTinyMarginEnd"/>
						<VBox class="fcrHeaderText">
							<HBox alignItems="Center">
								<core:Icon src="sap-icon://money-bills" size="1.5rem" class="sapUiTinyMarginEnd" color="#0a6ed1"/>
								<Title text="Fixed Cost Report - Budget Wise" level="H1" class="fcrTitle"/>
							</HBox>
						</VBox>
					</HBox>
					<!--<ObjectStatus text="{ui>/lastRunText}" state="Success" icon="sap-icon://sys-enter-2" class="fcrRunStatus"/>-->
				</HBox>
				<VBox class="fcrParamWrap">
					<HBox class="fcrParamHeader" alignItems="Center" justifyContent="SpaceBetween">
						<Title text="Report Parameters" level="H4"/>
					</HBox>
					<VBox id="paramGrid" class="fcrParamGrid">
						<HBox class="fcrParamRow" alignItems="End" justifyContent="Start" wrap="NoWrap">
							<VBox class="fcrField fcrFieldCc">
								<Label text="Company Code" required="true"/>
								<ComboBox id="budgetCcComboBox" selectedKey="{filters>/companyCode}" placeholder="Select Company Code" valueState="{ui>/companyCodeState}"
									width="100%">
									<core:Item key="1100" text="1100"/>
									<core:Item key="1600" text="1600"/>
								</ComboBox>
							</VBox>
							<VBox class="fcrField fcrFieldFy">
								<Label text="Fiscal Year" required="true"/>
								<ComboBox selectedKey="{filters>/fiscalYear}" items="{yearModel>/years}" change=".onFiscalYearChange" valueState="{ui>/fiscalYearState}"
									placeholder="Select FY">
									<core:Item key="{yearModel>key}" text="{yearModel>text}"/>
								</ComboBox>
							</VBox>
							<VBox class="fcrField fcrFieldQtr">
								<Label text="Period" required="true"/>
								<Input value="{parts:[{path:'filters>/period'},{path:'lookups>/periods'}], formatter: '.formatLookupText'}" showValueHelp="true"
									valueHelpOnly="true" valueHelpRequest=".onBudgetPeriodValueHelp" placeholder="Select Period" valueState="{ui>/periodState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldPc">
								<Label text="Profit Centre"/>
								<MultiInput id="profitCentreInputBudget" value="{path: 'filters>/profitCenters', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onProfitCentreValueHelp" placeholder="Select PC"/>
							</VBox>
							<VBox class="fcrField fcrFieldGlg">
								<Label text="GL Group"/>
								<MultiInput id="glGroupInputBudget" value="{path: 'filters>/glGroups', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onGlGroupValueHelp" placeholder="Select GL"/>
							</VBox>
							<HBox class="fcrActionsContainer" alignItems="Center">
								<Button icon="sap-icon://reset" tooltip="Reset" press=".onReset" class="fcrBtnReset"/>
								<Button text="Run Report" icon="sap-icon://play" type="Emphasized" press=".onSearch" class="fcrBtnRun"/>
							</HBox>
						</HBox>
					</VBox>
				</VBox>
			</VBox>
			<VBox>
				<layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="fcrKpiGrid">
					<HBox class="fcrModernCard fcrCardBgBlue" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgBlue">
							<core:Icon src="sap-icon://money-bills" class="fcrModernIcon fcrIconBlue"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="Current Year Budget" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/totalActual}" class="fcrModernValue fcrTextGreen"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox class="fcrModernCard fcrCardBgPurple" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgPurple">
							<core:Icon src="sap-icon://history" class="fcrModernIcon fcrIconPurple"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="Last Year Budget" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/totalBudget}" class="fcrModernValue fcrTextBlue"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox class="fcrModernCard fcrCardBgAmber" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgAmber">
							<core:Icon src="sap-icon://calendar" class="fcrModernIcon fcrIconAmber"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="Current Month Budget" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/totalVariance}" class="fcrModernValue fcrTextDark"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox class="fcrModernCard fcrCardBgBlue" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgBlue">
							<core:Icon src="sap-icon://bullet-text" class="fcrModernIcon fcrIconBlue"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="Last Two Months Budget" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/lastTwoMonthsTotal}" class="fcrModernValue fcrTextGreen"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
				</layout:Grid>
				<HBox justifyContent="SpaceBetween" alignItems="End" class="fcrSegmentToolbar">
					<HBox alignItems="End" class="fcrSegmentLeft">
						<VBox class="fcrModeBlock">
							<Label text="Report Type"/>
							<SegmentedButton selectedKey="{ui>/reportType}" selectionChange="onReportTypeChange" class="fcrViewSwitch">
								<items>
									<SegmentedButtonItem key="all" text="All GL" icon="sap-icon://detail-view" visible="false"/>
									<SegmentedButtonItem key="top" text="Top 5 GL" icon="sap-icon://vertical-bar-chart" visible="false"/>
									<SegmentedButtonItem key="budget" text="Budget Wise" icon="sap-icon://money-bills"/>
								</items>
							</SegmentedButton>
						</VBox>
					</HBox>
					<HBox alignItems="End">
						<SearchField width="18rem" placeholder="Search..." liveChange="onUniversalSearch" class="fcrToolbarSearch"/>
						<Button icon="sap-icon://excel-attachment" tooltip="Export" class="fcrToolbarExport sapUiTinyMarginBegin" press="onExport"/>
					</HBox>
				</HBox>
				<HBox alignItems="Center">
					<Text text="Selected Parameters : " class="fcrSubtitleText"/>
					<Text text="{ui>/periodText}" class="fcrSubtitle sapUiTinyMarginBegin"/>
				</HBox>
			</VBox>
			<VBox class="fcrContentSection">
				<Panel headerText="" expandable="false" expanded="true" class="fcrOutPanel">
					<content>
						<suite:ChartContainer id="budgetChartContainer" showFullScreen="true" showPersonalization="false" autoAdjustHeight="false"
							showLegendButton="false" title="Budget wise analysis (Amounts in Lakhs)" class="fcrChartContainer">
							<suite:content>
								<suite:ChartContainerContent icon="sap-icon://table-chart" title="Table View">
									<suite:content>
										<table:Table id="budgetTable" rows="{fcr>/budgetRows}" visibleRowCount="10" fixedColumnCount="2" selectionMode="None"
											enableColumnReordering="true" enableCellFilter="true" class="fcrUiTable">
											<table:columns>
												<table:Column width="8rem" sortProperty="glAccount" filterProperty="glAccount">
													<table:label>
														<Label text="G/L Account"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glAccount}"/>
													</table:template>
												</table:Column>
												<table:Column width="16rem" sortProperty="glName" filterProperty="glName">
													<table:label>
														<Label text="G/L Name"/>
													</table:label>
													<table:template>
														<Text text="{fcr>glName}"/>
													</table:template>
												</table:Column>
												<table:Column width="10rem" sortProperty="lastYearBudget" filterProperty="lastYearBudget" hAlign="End">
													<table:label>
														<Label text="Last Year Budget"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>lastYearBudgetText}"/>
													</table:template>
												</table:Column>
												<table:Column width="10rem" sortProperty="currentYearBudget" filterProperty="currentYearBudget" hAlign="End">
													<table:label>
														<Label text="Current Year Budget"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>currentYearBudgetText}"/>
													</table:template>
												</table:Column>
												<table:Column width="11rem" sortProperty="lastTwoMonthsBudget" filterProperty="lastTwoMonthsBudget" hAlign="End">
													<table:label>
														<Label text="Last Two Months Budget"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>lastTwoMonthsBudgetText}"/>
													</table:template>
												</table:Column>
												<table:Column width="10rem" sortProperty="currentMonthBudget" filterProperty="currentMonthBudget" hAlign="End">
													<table:label>
														<Label text="Current Month Budget"/>
													</table:label>
													<table:template>
														<ObjectNumber number="{fcr>currentMonthBudgetText}"/>
													</table:template>
												</table:Column>
											</table:columns>
										</table:Table>
									</suite:content>
								</suite:ChartContainerContent>
								<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Chart View">
									<suite:content>
										<viz:VizFrame id="budgetChart" width="100%" height="420px" vizType="column" uiConfig="{applicationSet:'fiori'}">
											<viz:dataset>
												<viz.data:FlattenedDataset data="{fcr>/budgetChart}">
													<viz.data:dimensions>
														<viz.data:DimensionDefinition name="G/L Account" value="{fcr>name}"/>
													</viz.data:dimensions>
													<viz.data:measures>
														<viz.data:MeasureDefinition name="Current Year Budget" value="{fcr>value}"/>
													</viz.data:measures>
												</viz.data:FlattenedDataset>
											</viz:dataset>
											<viz:feeds>
												<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Current Year Budget"/>
												<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="G/L Account"/>
											</viz:feeds>
										</viz:VizFrame>
									</suite:content>
								</suite:ChartContainerContent>
							</suite:content>
						</suite:ChartContainer>
					</content>
				</Panel>
			</VBox>
		</content>
	</Page>
</mvc:View>