<mvc:View controllerName="Z_Fixed_Cost_Report_FCR.controller.BudgetWise" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:table="sap.ui.table" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:suite="sap.suite.ui.commons" xmlns="sap.m" displayBlock="true">
	<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
		<content>
			<VBox class="fcrParamWrap">
				<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" type="Transparent" press=".onBack" tooltip="Back" class="sapUiTinyMarginEnd navBackButton"/>
						<VBox class="fcrHeaderText">
							<HBox alignItems="Center">
								<core:Icon src="sap-icon://money-bills" size="1.5rem" class="sapUiTinyMarginEnd" color="#0a6ed1"/>
								<Title text="Budget Report" level="H1" class="fcrTitle"/>
							</HBox>
						</VBox>
					</HBox>
				</HBox>
				<!--// Input Parameters //-->
				<VBox class="fcrParamWrap">
					<HBox class="fcrParamHeader" alignItems="Center" justifyContent="SpaceBetween">
						<Title text="Report Parameters" level="H4"/>
					</HBox>
					<VBox id="paramGrid" class="fcrParamGrid">
						<HBox class="fcrParamRow" alignItems="End" justifyContent="Start" wrap="NoWrap">
							<VBox class="fcrField fcrFieldCc">
								<Label text="Company Code" required="true"/>
								<ComboBox id="ccComboBox" selectedKey="{filters>/companyCode}" placeholder="Select Company Code" valueState="{ui>/companyCodeState}"
									width="100%">
									<core:Item key="1100" text="1100"/>
									<core:Item key="1600" text="1600"/>
								</ComboBox>
							</VBox>
							<VBox class="fcrField fcrFieldFy">
								<Label text="FY" required="true"/>
								<ComboBox selectedKey="{filters>/fiscalYear}" items="{lookups>/fiscalYears}" change=".onFiscalYearChange" valueState="{ui>/fiscalYearState}"
									placeholder="Select FY" width="100%">
									<core:Item key="{lookups>key}" text="{lookups>text}"/>
								</ComboBox>
							</VBox>
							<VBox class="fcrField fcrFieldQtr">
								<Label text="Period" required="false"/>
								<Input value="{parts:[{path:'filters>/period'},{path:'lookups>/periods'}], formatter: '.formatLookupText'}" showValueHelp="true"
									valueHelpOnly="true" valueHelpRequest=".onPeriodValueHelp" placeholder="Select Period" valueState="{ui>/periodState}"/>
							</VBox>
							<!--<VBox class="fcrField fcrFieldPc">-->
							<!--	<Label text="Cost Center" required="false"/>-->
							<!--	<Input value="{filters>/costCenter}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onCostCenterValueHelp"-->
							<!--		placeholder="Select Cost Center" valueState="{ui>/costCenterState}"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrField fcrFieldPc">-->
							<!--	<Label text="Cost Center Group" required="false"/>-->
							<!--	<Input value="{filters>/costCenterGroup}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onCostCenterGroupValueHelp"-->
							<!--		placeholder="Select Cost Center Group" valueState="{ui>/costCenterGroupState}"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrField fcrFieldGlg">-->
							<!--	<Label text="G/L Account" required="false"/>-->
							<!--	<Input value="{filters>/glAccount}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlAccountValueHelp"-->
							<!--		placeholder="Select G/L Account" valueState="{ui>/glAccountState}"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrField fcrFieldGlg" visible="{ui>/isGlMode}">-->
							<!--	<Label text="G/L Group" required="false"/>-->
							<!--	<Input value="{filters>/glGroup}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlGroupValueHelp"-->
							<!--		placeholder="Select G/L Group" valueState="{ui>/glGroupState}"/>-->
							<!--</VBox>-->
							<VBox class="fcrField fcrFieldPc">
								<Label text="Cost Center" required="false"/>
								<MultiInput id="costCenterInputBudget" value="{path: 'filters>/costCenter', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onCostCenterValueHelp" placeholder="Select Cost Center"
									valueState="{ui>/costCenterState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldPc">
								<Label text="Cost Center Group" required="false"/>
								<MultiInput id="costCenterGrpInputBudget" value="{path: 'filters>/costCenterGroup', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onCostCenterGroupValueHelp" placeholder="Select Cost Center Group"
									valueState="{ui>/costCenterGroupState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldGlg">
								<Label text="G/L Account" required="false"/>
								<MultiInput id="glAccountInputBudget" value="{path: 'filters>/glAccount', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onGlAccountValueHelp" placeholder="Select G/L Account"
									valueState="{ui>/glAccountState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldGlg" visible="{ui>/isGlMode}">
								<Label text="G/L Group" required="false"/>
								<MultiInput id="glGroupInputBudget" value="{path: 'filters>/glGroup', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onGlGroupValueHelp" placeholder="Select G/L Group"
									valueState="{ui>/glGroupState}"/>
							</VBox>
							<HBox class="fcrActionsContainer" alignItems="Center">
								<Button icon="sap-icon://reset" tooltip="Reset" press=".onReset" class="fcrBtnReset"/>
								<Button text="Run Report" icon="sap-icon://play" type="Emphasized" press=".onSearch" class="fcrBtnRun"/>
							</HBox>
						</HBox>
					</VBox>
				</VBox>
			</VBox>
			<!--// KPIs //-->
			<VBox>
				<layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="fcrKpiGrid">
					<HBox class="fcrModernCard fcrCardBgBlue" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgBlue">
							<core:Icon src="sap-icon://money-bills" class="fcrModernIcon fcrIconBlue"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="{ui>/kpi1Label}" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/kpi1Value}" class="fcrModernValue fcrTextGreen"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox class="fcrModernCard fcrCardBgPurple" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgPurple">
							<core:Icon src="sap-icon://history" class="fcrModernIcon fcrIconPurple"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="{ui>/kpi2Label}" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/kpi2Value}" class="fcrModernValue fcrTextBlue"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox class="fcrModernCard fcrCardBgAmber" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgAmber">
							<core:Icon src="sap-icon://calendar" class="fcrModernIcon fcrIconAmber"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="{ui>/kpi3Label}" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/kpi3Value}" class="fcrModernValue fcrTextGreen"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox class="fcrModernCard fcrCardBgGreen" alignItems="Center">
						<VBox class="fcrModernIconWrap fcrIconBgBlue">
							<core:Icon src="sap-icon://bullet-text" class="fcrModernIcon fcrIconBlue"/>
						</VBox>
						<VBox class="fcrModernDataWrap">
							<Text text="{ui>/kpi4Label}" class="fcrModernTitle"/>
							<HBox alignItems="Baseline" class="fcrModernValueLine">
								<Text text="{ui>/kpi4Value}" class="fcrModernValue fcrTextBlue"/>
								<Text text="Lakhs INR" class="fcrModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
				</layout:Grid>
				<!--<HBox alignItems="Center">-->
				<!--	<Text text="Selected Parameters : " class="fcrSubtitleText"/>-->
				<!--	<Text text="{ui>/selectedParamsText}" class="fcrSubtitle sapUiTinyMarginBegin"/>-->
				<!--</HBox>-->
				<HBox justifyContent="SpaceBetween" alignItems="End" class="fcrSegmentToolbar">
					<HBox alignItems="End" class="fcrSegmentLeft">
						<VBox class="fcrModeBlock">
							<Label text="Report Type"/>
							<SegmentedButton selectedKey="{ui>/reportType}" selectionChange=".onReportTypeChange" class="fcrViewSwitch">
								<items>
									<SegmentedButtonItem key="GL" text="G/L Group Wise" icon="sap-icon://detail-view"/>
									<SegmentedButtonItem key="NONGL" text="Non G/L wise" icon="sap-icon://money-bills"/>
								</items>
							</SegmentedButton>
						</VBox>
					</HBox>
					<HBox alignItems="End">
						<SearchField width="18rem" placeholder="Search..." liveChange=".onUniversalSearch" class="fcrToolbarSearch"/>
						<Button icon="sap-icon://excel-attachment" tooltip="Export" class="fcrToolbarExport sapUiTinyMarginBegin" press=".onExport"/>
					</HBox>
				</HBox>
				<HBox alignItems="Center">
					<Text text="Selected Parameters : " class="fcrSubtitleText"/>
					<Text text="{ui>/selectedParamsText}" class="fcrSubtitle sapUiTinyMarginBegin"/>
				</HBox>
			</VBox>
			<!--// GL Wise //-->
			<VBox class="fcrContentSection">
				<VBox visible="{ui>/isGlMode}">
					<Panel headerText="G/L Group Wise Top 5 Budget View" expandable="false" expanded="true" class="fcrOutPanel sapUiSmallMarginBottom"
						visible="false">
						<content>
							<layout:Grid defaultSpan="L6 M6 S12">
								<suite:ChartContainer id="ccTop5ColGl" title="Top 5 Uploaded Yearly Budget" showFullScreen="true" showPersonalization="false"
									autoAdjustHeight="false" showLegendButton="false">
									<suite:content>
										<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Column Chart View">
											<suite:content>
												<viz:VizFrame id="top5ColumnChartGl" width="100%" height="320px" vizType="column" uiConfig="{applicationSet:'fiori'}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{budget>/top5ColumnData}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Category" value="{budget>name}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="Uploaded Yearly Budget" value="{budget>columnValue}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds>
														<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Uploaded Yearly Budget"/>
														<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Category"/>
													</viz:feeds>
												</viz:VizFrame>
											</suite:content>
										</suite:ChartContainerContent>
									</suite:content>
								</suite:ChartContainer>
								<suite:ChartContainer id="ccTop5PieGl" title="Top 5 Current Month Value" showFullScreen="true" showPersonalization="false"
									autoAdjustHeight="false" showLegendButton="false">
									<suite:content>
										<suite:ChartContainerContent icon="sap-icon://pie-chart" title="Pie Chart View">
											<suite:content>
												<viz:VizFrame id="top5PieChartGl" width="100%" height="320px" vizType="pie" uiConfig="{applicationSet:'fiori'}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{budget>/top5PieData}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Category" value="{budget>name}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="Current Month Value" value="{budget>pieValue}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds>
														<viz.feeds:FeedItem uid="size" type="Measure" values="Current Month Value"/>
														<viz.feeds:FeedItem uid="color" type="Dimension" values="Category"/>
													</viz:feeds>
												</viz:VizFrame>
											</suite:content>
										</suite:ChartContainerContent>
									</suite:content>
								</suite:ChartContainer>
							</layout:Grid>
						</content>
					</Panel>
					<Panel headerText="" expandable="false" expanded="true" class="fcrOutPanel" visible="true">
						<content>
							<suite:ChartContainer id="budgetGlChartContainer" showFullScreen="true" showPersonalization="false" autoAdjustHeight="false"
								showLegendButton="false" title="G/L Group Wise Details Budget View" class="fcrChartContainer">
								<suite:content>
									<suite:ChartContainerContent icon="sap-icon://table-chart" title="Table View">
										<suite:content>
											<table:Table id="budgetGlTable" rows="{budget>/glRows}" visibleRowCount="10" fixedColumnCount="3" selectionMode="None"
												enableColumnReordering="true" enableCellFilter="true" noDataText="Run report to display G/L budget rows" class="fcrUiTable">
												<table:columns>
													<table:Column width="8rem" sortProperty="costCenter" filterProperty="costCenter">
														<table:label><Label text="Cost Center"/></table:label>
														<table:template><Text text="{budget>costCenter}"/></table:template>
													</table:Column>
													<table:Column width="12rem" sortProperty="costCenterDesc" filterProperty="costCenterDesc">
														<table:label><Label text="Cost Center Description"/></table:label>
														<table:template><Text text="{budget>costCenterDesc}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="coGroup" filterProperty="coGroup">
														<table:label><Label text="Cost Centre Group"/></table:label>
														<table:template><Text text="{budget>coGroup}"/></table:template>
													</table:Column>
													<table:Column width="12rem" sortProperty="gl" filterProperty="gl">
														<table:label><Label text="G/L Account"/></table:label>
														<table:template><Text text="{budget>gl}"/></table:template>
													</table:Column>
													<table:Column width="12rem" sortProperty="glDesc" filterProperty="glDesc">
														<table:label><Label text="G/L Description"/></table:label>
														<table:template><Text text="{budget>glDesc}"/></table:template>
													</table:Column>
													<table:Column width="12rem" sortProperty="glGroup" filterProperty="glGroup">
														<table:label><Label text="G/L Group"/></table:label>
														<table:template><Text text="{budget>glGroup}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="oldYearlyValue" filterProperty="oldYearlyValue" hAlign="End">
														<table:label><Label text="Last Year Actual"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>oldYearlyValue', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="yearlyBudget" filterProperty="yearlyBudget" hAlign="End">
														<table:label><Label text="Current Year Budget"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>yearlyBudget', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
													<table:Column width="13rem" sortProperty="previousTwoMonthsValue" filterProperty="previousTwoMonthsValue" hAlign="End">
														<table:label><Label text="Last Two Months Actual Value"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>previousTwoMonthsValue', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
													<table:Column width="12rem" sortProperty="currentMonthValue" filterProperty="currentMonthValue" hAlign="End">
														<table:label><Label text="Current Month Value"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>currentMonthValue', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
												</table:columns>
											</table:Table>
										</suite:content>
									</suite:ChartContainerContent>
									<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Chart View">
										<suite:content>
											<viz:VizFrame id="budgetGlChart" width="100%" height="420px" vizType="column" uiConfig="{applicationSet:'fiori'}">
												<viz:dataset>
													<viz.data:FlattenedDataset data="{budget>/glChartRows}">
														<viz.data:dimensions>
															<viz.data:DimensionDefinition name="Category" value="{budget>name}"/>
														</viz.data:dimensions>
														<viz.data:measures>
															<viz.data:MeasureDefinition name="Uploaded Yearly Budget" value="{budget>value}"/>
														</viz.data:measures>
													</viz.data:FlattenedDataset>
												</viz:dataset>
												<viz:feeds>
													<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Uploaded Yearly Budget"/>
													<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Category"/>
												</viz:feeds>
											</viz:VizFrame>
										</suite:content>
									</suite:ChartContainerContent>
								</suite:content>
							</suite:ChartContainer>
						</content>
					</Panel>
				</VBox>
				<VBox visible="{ui>/isNonGlMode}">
					<Panel headerText="Non G/L Wise Top 5 Budget View" expandable="false" expanded="true" class="fcrOutPanel sapUiSmallMarginBottom"
						visible="false">
						<content>
							<layout:Grid defaultSpan="L6 M6 S12">
								<suite:ChartContainer id="ccTop5ColNonGl" title="Top 5 Uploaded Yearly Budget" showFullScreen="true" showPersonalization="false"
									autoAdjustHeight="false" showLegendButton="false">
									<suite:content>
										<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Column Chart View">
											<suite:content>
												<viz:VizFrame id="top5ColumnChartNonGl" width="100%" height="320px" vizType="column" uiConfig="{applicationSet:'fiori'}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{budget>/top5ColumnData}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Category" value="{budget>name}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="Uploaded Yearly Budget" value="{budget>columnValue}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds>
														<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Uploaded Yearly Budget"/>
														<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Category"/>
													</viz:feeds>
												</viz:VizFrame>
											</suite:content>
										</suite:ChartContainerContent>
									</suite:content>
								</suite:ChartContainer>
								<suite:ChartContainer id="ccTop5PieNonGl" title="Top 5 Current Month Value" showFullScreen="true" showPersonalization="false"
									autoAdjustHeight="false" showLegendButton="false">
									<suite:content>
										<suite:ChartContainerContent icon="sap-icon://pie-chart" title="Pie Chart View">
											<suite:content>
												<viz:VizFrame id="top5PieChartNonGl" width="100%" height="320px" vizType="pie" uiConfig="{applicationSet:'fiori'}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{budget>/top5PieData}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Category" value="{budget>name}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="Current Month Value" value="{budget>pieValue}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds>
														<viz.feeds:FeedItem uid="size" type="Measure" values="Current Month Value"/>
														<viz.feeds:FeedItem uid="color" type="Dimension" values="Category"/>
													</viz:feeds>
												</viz:VizFrame>
											</suite:content>
										</suite:ChartContainerContent>
									</suite:content>
								</suite:ChartContainer>
							</layout:Grid>
						</content>
					</Panel>
					<Panel headerText="" expandable="false" expanded="true" class="fcrOutPanel" visible="true">
						<content>
							<suite:ChartContainer id="budgetNonGlChartContainer" showFullScreen="true" showPersonalization="false" autoAdjustHeight="false"
								showLegendButton="false" title="Non G/L Wise Details Budget View" class="fcrChartContainer">
								<suite:content>
									<suite:ChartContainerContent icon="sap-icon://table-chart" title="Table View">
										<suite:content>
											<table:Table id="budgetNonGlTable" rows="{budget>/nonGlRows}" visibleRowCount="10" fixedColumnCount="2" selectionMode="None"
												enableColumnReordering="true" enableCellFilter="true" noDataText="Run report to display non G/L budget rows" class="fcrUiTable">
												<table:columns>
													<table:Column width="10rem" sortProperty="coGroup" filterProperty="coGroup">
														<table:label><Label text="Cost Centre Group"/></table:label>
														<table:template><Text text="{budget>coGroup}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="costCenter" filterProperty="costCenter">
														<table:label><Label text="Cost Center"/></table:label>
														<table:template><Text text="{budget>costCenter}"/></table:template>
													</table:Column>
													<table:Column width="14rem" sortProperty="costCenterDesc" filterProperty="costCenterDesc">
														<table:label><Label text="Cost Center Description"/></table:label>
														<table:template><Text text="{budget>costCenterDesc}"/></table:template>
													</table:Column>
													<!--<table:Column width="12rem" sortProperty="gl" filterProperty="gl">-->
													<!--	<table:label><Label text="G/L Account"/></table:label>-->
													<!--	<table:template><Text text="{budget>gl}"/></table:template>-->
													<!--</table:Column>-->
													<table:Column width="10rem" sortProperty="oldYearlyValue" filterProperty="oldYearlyValue" hAlign="End">
														<table:label><Label text="Last Year Actual"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>oldYearlyValue', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
													<table:Column width="10rem" sortProperty="yearlyBudget" filterProperty="yearlyBudget" hAlign="End">
														<table:label><Label text="Current Year Budget"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>yearlyBudget', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
													<table:Column width="13rem" sortProperty="previousTwoMonthsValue" filterProperty="previousTwoMonthsValue" hAlign="End">
														<table:label><Label text="Last Two Months Actual Value"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>previousTwoMonthsValue', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
													<table:Column width="12rem" sortProperty="currentMonthValue" filterProperty="currentMonthValue" hAlign="End">
														<table:label><Label text="Current Month Value"/></table:label>
														<table:template><ObjectNumber number="{path: 'budget>currentMonthValue', formatter: '.formatTableAmount'}"/></table:template>
													</table:Column>
												</table:columns>
											</table:Table>
										</suite:content>
									</suite:ChartContainerContent>
									<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Chart View">
										<suite:content>
