<mvc:View controllerName="Z_Fixed_Cost_Report_FCR.controller.BudgetWise" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:table="sap.ui.table" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:suite="sap.suite.ui.commons" xmlns="sap.m" displayBlock="true">
	<Page showHeader="false" enableScrolling="true" class="fcrPageShell">
		<content>
			<VBox class="fcrParamWrap">
				<HBox class="fcrHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<VBox class="fcrHeaderText">
							<HBox alignItems="Center">
								<core:Icon src="sap-icon://money-bills" size="1.5rem" class="sapUiTinyMarginEnd" color="#0a6ed1"/>
								<Title text="Cost Centre Budget Dashboard" level="H1" class="fcrTitle"/>
							</HBox>
						</VBox>
					</HBox>
					<HBox alignItems="Center">
						<Button text="Fixed Cost Report" icon="sap-icon://display" type="Emphasized" press=".onNavToView1" class="fcrBtnBudget"/>
					</HBox>
				</HBox>
				<!--// Input Parameters //-->
				<VBox class="fcrParamWrap fcrParamCardModern">
					<HBox class="fcrParamHeader fcrParamHeaderModern" alignItems="Center" justifyContent="SpaceBetween">
						<Title text="Report Parameters" level="H4"/>
					</HBox>
					<VBox id="paramGrid" class="fcrParamGrid fcrParamGridModern">
						<HBox class="fcrParamRow fcrParamRowModern fcrParamRowTop" alignItems="End" justifyContent="Start" wrap="NoWrap">
							<VBox class="fcrField fcrFieldCc">
								<Label text="Company Code" required="true"/>
								<ComboBox id="ccComboBox" selectedKey="{filters>/companyCode}" placeholder="Select Company Code" valueState="{ui>/companyCodeState}"
									width="100%">
									<core:Item key="1100" text="1100"/>
									<core:Item key="1600" text="1600"/>
								</ComboBox>
							</VBox>
							<VBox class="fcrField fcrFieldFy">
								<Label text="FY" required="true"/>
								<ComboBox selectedKey="{filters>/fiscalYear}" items="{lookups>/fiscalYears}" change=".onFiscalYearChange" valueState="{ui>/fiscalYearState}"
									placeholder="Select FY" width="100%">
									<core:Item key="{lookups>key}" text="{lookups>text}"/>
								</ComboBox>
							</VBox>
							<!--<VBox class="fcrField fcrFieldQtr">-->
							<!--	<Label text="Period" required="false"/>-->
							<!--<Input value="{parts:[{path:'filters>/period'},{path:'lookups>/periods'}], formatter: '.formatLookupText'}" showValueHelp="true"-->
							<!--	valueHelpOnly="true" valueHelpRequest=".onPeriodValueHelp" placeholder="Select Period" valueState="{ui>/periodState}"/>-->
							<!--	<MultiInput id="periodInputBudget" value="{path: 'filters>/period', formatter: '.formatBudgetTokenKeys'}" showValueHelp="true"-->
							<!--		valueHelpOnly="true" tokenUpdate=".onBudgetTokenUpdate" valueHelpRequest=".onBudgetPeriodValueHelp" placeholder="Select Period(s)"-->
							<!--		valueState="{ui>/periodState}"/>-->
							<!--</VBox>-->
							<VBox class="fcrField fcrFieldQtr">
								<Label text="Upto Period" required="false"/>
								<MultiInput id="periodInputBudget" value="{path: 'filters>/period', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onBudgetTokenUpdate" valueHelpRequest=".onBudgetPeriodValueHelp" placeholder="Select Period(s)"
									enabled="{ui>/periodEnabled}" tooltip="Choose either Period or Quarter. Do not use both together." valueState="{ui>/periodState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldQtr">
								<Label text="Quarter"/>
								<MultiInput id="quarterInputBudget" value="{path: 'filters>/quarters', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onQuarterValueHelp" placeholder="Select Quarter(s)"
									enabled="{ui>/quarterEnabled}" tooltip="Choose either Period or Quarter. Do not use both together." valueState="{ui>/quarterState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldQtr">
								<Label text="Utilisation Basis" required="false"/>
								<Select id="budgetCategorySelect" selectedKey="{filters>/budgetCategory}" change=".onBudgetCategoryChange" width="100%">
									<core:Item key="" text="Select Category"/>
									<core:Item key="T" text="Total Budget"/>
									<core:Item key="R" text="Released Budget"/>
								</Select>
							</VBox>
							<VBox class="fcrField fcrFieldQtr">
								<Label text="Status" required="false"/>
								<Select id="statusSelect" selectedKey="{filters>/status}" change=".onStatusChange" width="100%">
									<core:Item key="" text="Select Status"/>
									<core:Item key="R" text="Red"/>
									<core:Item key="G" text="Green"/>
								</Select>
							</VBox>
						</HBox>
						<HBox class="fcrParamRow fcrParamRowModern fcrParamRowBottom" alignItems="End" justifyContent="Start" wrap="Wrap">
							<!--<VBox class="fcrField fcrFieldPc">-->
							<!--	<Label text="Cost Center" required="false"/>-->
							<!--	<Input value="{filters>/costCenter}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onCostCenterValueHelp"-->
							<!--		placeholder="Select Cost Center" valueState="{ui>/costCenterState}"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrField fcrFieldPc">-->
							<!--	<Label text="Cost Center Group" required="false"/>-->
							<!--	<Input value="{filters>/costCenterGroup}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onCostCenterGroupValueHelp"-->
							<!--		placeholder="Select Cost Center Group" valueState="{ui>/costCenterGroupState}"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrField fcrFieldGlg">-->
							<!--	<Label text="G/L Account" required="false"/>-->
							<!--	<Input value="{filters>/glAccount}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlAccountValueHelp"-->
							<!--		placeholder="Select G/L Account" valueState="{ui>/glAccountState}"/>-->
							<!--</VBox>-->
							<!--<VBox class="fcrField fcrFieldGlg" visible="{ui>/isGlMode}">-->
							<!--	<Label text="G/L Group" required="false"/>-->
							<!--	<Input value="{filters>/glGroup}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".onGlGroupValueHelp"-->
							<!--		placeholder="Select G/L Group" valueState="{ui>/glGroupState}"/>-->
							<!--</VBox>-->
							<VBox class="fcrField fcrFieldPc" visible="{= !${ui>/isGlMode} }">
								<Label text="Cost Center" required="false"/>
								<MultiInput id="costCenterInputBudget" value="{path: 'filters>/costCenter', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onCostCenterValueHelp" placeholder="Select Cost Center"
									valueState="{ui>/costCenterState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldGlg" visible="{ui>/isGlMode}">
								<Label text="G/L Account" required="false"/>
								<MultiInput id="glAccountInputBudget" value="{path: 'filters>/glAccount', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onGlAccountValueHelp" placeholder="Select G/L Account"
									valueState="{ui>/glAccountState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldPc" visible="{= !${ui>/isGlMode} }">
								<Label text="Cost Center Group" required="false"/>
								<MultiInput id="costCenterGrpInputBudget" value="{path: 'filters>/costCenterGroup', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onCostCenterGroupValueHelp" placeholder="Select Cost Center Group"
									valueState="{ui>/costCenterGroupState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldPc" visible="{= !${ui>/isGlMode} }">
								<Label text="Cost Centre Owner" required="false"/>
								<MultiInput id="costCenterOwnerInputBudget" value="{path: 'filters>/costCenterOwner', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onCostCenterOwnerValueHelp" placeholder="Select Cost Centre Owner"
									valueState="{ui>/costCenterOwnerState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldGlg" visible="{ui>/isGlMode}">
								<Label text="G/L Group" required="false"/>
								<MultiInput id="glGroupInputBudget" value="{path: 'filters>/glGroup', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onGlGroupValueHelp" placeholder="Select G/L Group"
									valueState="{ui>/glGroupState}"/>
							</VBox>
							<VBox class="fcrField fcrFieldGlg" visible="{= !${ui>/isGlMode} }">
								<Label text="G/L Group" required="false"/>
								<MultiInput id="nonGlGlGroupInputBudget" value="{path: 'filters>/nonGlGlGroup', formatter: '.formatTokenKeys'}" showValueHelp="true"
									valueHelpOnly="true" tokenUpdate=".onTokenUpdate" valueHelpRequest=".onNonGlGlGroupValueHelp" placeholder="Select G/L Group"
									valueState="{ui>/nonGlGlGroupState}"/>
							</VBox>
							<HBox class="fcrActionsContainer fcrParamActionsModern" alignItems="Center">
								<Button icon="sap-icon://reset" tooltip="Reset" press=".onReset" class="fcrBtnReset"/>
								<Button text="Run Report" icon="sap-icon://play" type="Emphasized" press=".onSearch" class="fcrBtnRun"/>
							</HBox>
						</HBox>
					</VBox>
				</VBox>
			</VBox>
			<!--// KPIs //-->
			<VBox>
				<layout:Grid defaultSpan="XL6 L6 M6 S12" class="bwKpiGrid bwKpiGridSecondary">
					<!-- KPI 6 -->
					<!--<HBox class="bwModernCard bwCardBgAmber" alignItems="Center">-->
					<!--	<VBox class="bwModernIconWrap bwIconBgAmber">-->
					<!--		<core:Icon src="sap-icon://group" class="bwModernIcon bwIconAmber"/>-->
					<!--	</VBox>-->
					<!--	<VBox class="bwModernDataWrap">-->
					<!--		<Text text="{= ${ui>/isGlMode} ? 'Highest Total Budget Cost Centre Group' : 'Highest Total Budget GL Group' }"-->
					<!--			tooltip="{= ${ui>/isGlMode} ? 'Highest Total Budget Cost Centre Group' : 'Highest Total Budget GL Group' }" class="bwKpiLeadText"-->
					<!--			wrapping="true"/>-->
					<!--		<Text text="{ui>/kpi6Subtext}" tooltip="{ui>/kpi6Subtext}" class="fcrModernValue fcrTextBlue fcrGlNameText"/>-->
					<!--		<HBox alignItems="Baseline" class="fcrModernValueLine">-->
					<!--			<Text text="{ui>/kpi6Value}" class="bwKpiLeadAmount bwTextGreen"/>-->
					<!--			<Text text=" Lakhs INR" class="bwKpiLeadUnit"/>-->
					<!--		</HBox>-->
					<!--	</VBox>-->
					<!--</HBox>-->
					<!-- KPI 7 -->
					<HBox width="100%" class="bwModernCard bwCardBgAmber" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgAmber">
							<core:Icon src="sap-icon://group" class="bwModernIcon bwIconAmber"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Top 3 Cost Centre by Total Budget" class="bwModernTitle" wrapping="true"/>
							<List class="bwKpiBulletList" items="{ui>/kpi7Bullets}" showSeparators="None" mode="None">
								<CustomListItem>
									<HBox class="bwKpiBulletItem" alignItems="Start">
										<Text text="&#8226;" class="bwKpiBulletDot"/>
										<Text text="{ui>text}" class="bwKpiBulletText bwKpiBulletTextGreen" wrapping="true"/>
									</HBox>
								</CustomListItem>
							</List>
						</VBox>
					</HBox>
					<!-- KPI 8 -->
					<HBox width="100%" class="bwModernCard bwCardBgPurple" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgPurple">
							<core:Icon src="sap-icon://list" class="bwModernIcon bwIconPurple"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Top 3 GL Groups by Total Budget" class="bwModernTitle" wrapping="true"/>
							<List class="bwKpiBulletList" items="{ui>/kpi8Bullets}" showSeparators="None" mode="None">
								<CustomListItem>
									<HBox class="bwKpiBulletItem" alignItems="Start">
										<Text text="&#8226;" class="bwKpiBulletDot"/>
										<Text text="{ui>text}" class="bwKpiBulletText" wrapping="true"/>
									</HBox>
								</CustomListItem>
							</List>
						</VBox>
					</HBox>
				</layout:Grid>
				<layout:Grid defaultSpan="XL6 L6 M6 S12" class="bwKpiGrid">
					<!-- KPI 1 -->
					<HBox class="bwModernCard bwCardBgBlue" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgBlue">
							<core:Icon src="sap-icon://money-bills" class="bwModernIcon bwIconBlue"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Total Budget" class="bwModernTitle"/>
							<HBox alignItems="Baseline" class="bwModernValueLine">
								<Text text="{ui>/kpi1Value}" class="bwModernValue bwTextGreen"/>
								<Text text="Lakhs INR" class="bwModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<!-- KPI 2 -->
					<HBox class="bwModernCard bwCardBgPurple" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgPurple">
							<core:Icon src="sap-icon://history" class="bwModernIcon bwIconPurple"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Total Released Budget" class="bwModernTitle"/>
							<HBox alignItems="Baseline" class="bwModernValueLine">
								<Text text="{ui>/kpi2Value}" class="bwModernValue bwTextBlue"/>
								<Text text="Lakhs INR" class="bwModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<!-- KPI 3 -->
					<HBox class="bwModernCard bwCardBgRed" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgRed">
							<core:Icon src="sap-icon://expense-report" class="bwModernIcon bwIconRed"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Total Spent" class="bwModernTitle"/>
							<HBox alignItems="Baseline" class="bwModernValueLine">
								<Text text="{ui>/kpi3Value}" class="bwModernValue fcrTextDark"/>
								<Text text="Lakhs INR" class="bwModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<!-- KPI 4 -->
					<HBox class="bwModernCard bwCardBgAmber" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgAmber">
							<core:Icon src="sap-icon://value-help" class="bwModernIcon bwIconAmber"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Available Budget" class="bwModernTitle"/>
							<HBox alignItems="Baseline" class="bwModernValueLine">
								<Text text="{ui>/kpi4Value}" class="bwModernValue bwTextGreen"/>
								<Text text="Lakhs INR" class="bwModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
					<!-- KPI 5 -->
					<HBox class="bwModernCard bwCardBgGreen" alignItems="Center">
						<VBox class="bwModernIconWrap bwIconBgGreen">
							<core:Icon src="sap-icon://performance" class="bwModernIcon bwIconGreen"/>
						</VBox>
						<VBox class="bwModernDataWrap">
							<Text text="Utilisation (%)" class="bwModernTitle"/>
							<HBox alignItems="Baseline" class="bwModernValueLine">
								<Text text="{ui>/kpi5Value}" class="bwModernValue bwTextBlue"/>
								<Text text="&#9650;" visible="{= ${ui>/kpi5ValueRaw} &gt; 100 }" class="bwKpiTrendArrow bwTrendUp"/>
								<Text text="&#9660;" visible="{= ${ui>/kpi5ValueRaw} &lt; 100 }" class="bwKpiTrendArrow bwTrendDown"/>
								<Text text="%" class="bwModernUnit"/>
							</HBox>
						</VBox>
					</HBox>
				</layout:Grid>
				<!--<HBox alignItems="Center">-->
				<!--	<Text text="Selected Parameters : " class="fcrSubtitleText"/>-->
				<!--	<Text text="{ui>/selectedParamsText}" class="fcrSubtitle sapUiTinyMarginBegin"/>-->
				<!--</HBox>-->
				<HBox justifyContent="SpaceBetween" alignItems="End" class="fcrSegmentToolbar">
					<HBox alignItems="End" class="fcrSegmentLeft">
						<VBox class="fcrModeBlock">
							<Label text="Report Type"/>
							<SegmentedButton selectedKey="{ui>/reportType}" selectionChange=".onReportTypeChange" class="fcrViewSwitch">
								<items>
									<SegmentedButtonItem key="GL" text="G/L Parameters" icon="sap-icon://detail-view"/>
									<SegmentedButtonItem key="NONGL" text="Cost Centre Parameters" icon="sap-icon://money-bills"/>
								</items>
							</SegmentedButton>
						</VBox>
					</HBox>
					<HBox alignItems="End">
						<SearchField width="18rem" placeholder="Search..." liveChange=".onUniversalSearch" class="fcrToolbarSearch"/>
						<Button icon="sap-icon://excel-attachment" tooltip="Export" class="fcrToolbarExport sapUiTinyMarginBegin" press=".onExport"/>
					</HBox>
				</HBox>
				<!--<HBox alignItems="Center">-->
				<!--	<Text text="Selected Parameters : " class="fcrSubtitleText"/>-->
				<!--	<Text text="{ui>/selectedParamsText}" class="fcrSubtitle sapUiTinyMarginBegin"/>-->
				<!--</HBox>-->
				<VBox class="fcrBudgetChartSection">
					<VBox visible="{ui>/isGlMode}">
						<viz:VizFrame id="budgetGlChart" width="100%" height="350px" vizType="pie" uiConfig="{applicationSet:'fiori'}">
							<viz:dataset>
								<viz.data:FlattenedDataset data="{budget>/glChartRows}">
									<viz.data:dimensions>
										<viz.data:DimensionDefinition name="Cost Centre Name" value="{budget>costCentreDesc}"/>
									</viz.data:dimensions>
									<viz.data:measures>
										<viz.data:MeasureDefinition name="Total Budget" value="{budget>yearlyBudget}"/>
									</viz.data:measures>
								</viz.data:FlattenedDataset>
							</viz:dataset>
							<viz:feeds>
								<viz.feeds:FeedItem uid="size" type="Measure" values="Total Budget"/>
								<viz.feeds:FeedItem uid="color" type="Dimension" values="Cost Centre Name"/>
							</viz:feeds>
							<viz:dependents>
								<viz:Popover id="budgetGlPopover"/>
							</viz:dependents>
						</viz:VizFrame>
					</VBox>
					<VBox visible="{ui>/isNonGlMode}">
						<viz:VizFrame id="budgetNonGlChart" width="100%" height="350px" vizType="pie" uiConfig="{applicationSet:'fiori'}">
							<viz:dataset>
								<viz.data:FlattenedDataset data="{budget>/nonGlChartRows}">
									<viz.data:dimensions>
										<viz.data:DimensionDefinition name="G/L Group" value="{budget>glGroup}"/>
									</viz.data:dimensions>
									<viz.data:measures>
										<viz.data:MeasureDefinition name="Actual Yearly Budget" value="{budget>yearlyBudget}"/>
									</viz.data:measures>
								</viz.data:FlattenedDataset>
							</viz:dataset>
							<viz:feeds>
								<viz.feeds:FeedItem uid="size" type="Measure" values="Actual Yearly Budget"/>
								<viz.feeds:FeedItem uid="color" type="Dimension" values="G/L Group"/>
							</viz:feeds>
							<viz:dependents>
								<viz:Popover id="budgetNonGlPopover"/>
							</viz:dependents>
						</viz:VizFrame>
					</VBox>
					<VBox class="sapUiSmallMarginTop">
						<viz:VizFrame id="budgetMonthlyTrendChart" width="100%" height="250px" vizType="line" uiConfig="{applicationSet:'fiori'}">
							<viz:dataset>
								<viz.data:FlattenedDataset data="{budget>/monthTrendData}">
									<viz.data:dimensions>
										<viz.data:DimensionDefinition name="Month" value="{budget>monthLabel}"/>
									</viz.data:dimensions>
									<viz.data:measures>
										<viz.data:MeasureDefinition name="Monthly Spend" value="{budget>monthlyValue}"/>
									</viz.data:measures>
								</viz.data:FlattenedDataset>
							</viz:dataset>
							<viz:feeds>
								<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Month"/>
								<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Monthly Spend"/>
							</viz:feeds>
							<viz:dependents>
								<viz:Popover id="budgetMonthlyTrendPopover"/>
							</viz:dependents>
						</viz:VizFrame>
					</VBox>
				</VBox>
			</VBox>
			<!--// GL Wise //-->
			<VBox class="fcrContentSection">
				<VBox visible="{ui>/isGlMode}">
					<Panel headerText="Cost Centre Wise Top 3 Budget View (Amounts in ₹ Lakhs)" expandable="false" expanded="true"
						class="fcrOutPanel sapUiSmallMarginBottom" visible="false">
						<content>
							<layout:Grid defaultSpan="L6 M6 S12">
								<suite:ChartContainer id="ccTop5ColGl" title="Top 3 Current Year Budget" showFullScreen="true" showPersonalization="false"
									autoAdjustHeight="false" showLegendButton="false">
									<suite:content>
										<suite:ChartContainerContent icon="sap-icon://bar-chart" title="Column Chart View">
											<suite:content>
												<viz:VizFrame id="top5ColumnChartGl" width="100%" height="320px" vizType="column" uiConfig="{applicationSet:'fiori'}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{budget>/top5ColumnData}">
															<viz.data:dimensions>
												<viz.data:DimensionDefinition name="Cost Centre Name" value="{budget>costCentreDesc}"/>
															</viz.data:dimensions>
															<viz.data:measures>
																<viz.data:MeasureDefinition name="Current Year Budget" value="{budget>columnValue}"/>
															</viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds>
														<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Current Year Budget"/>
														<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Cost Centre Name"/>
													</viz:feeds>
													<viz:dependents>
														<viz:Popover id="top5ColumnPopoverGl"/>
													</viz:dependents>
												</viz:VizFrame>
											</suite:content>
										</suite:ChartContainerContent>
									</suite:content>
								</suite:ChartContainer>
								<suite:ChartContainer id="ccTop5PieGl" title="Top 3 Actual Yearly Budget Value" showFullScreen="true" showPersonalization="false"
									autoAdjustHeight="false" showLegendButton="false">
									<suite:content>
										<suite:ChartContainerContent icon="sap-icon://pie-chart" title="Pie Chart View">
											<suite:content>
												<viz:VizFrame id="top5PieChartGl" width="100%" height="320px" vizType="donut" uiConfig="{applicationSet:'fiori'}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{budget>/top5PieData}">
															<viz.data:dimensions>
																<viz.data:DimensionDefinition name="Cost Centre Group" value="{budget>coGroup}"/>
															</viz.data:dimensions>
															<viz.data:measures>
																<viz.data:MeasureDefinition name="Actual Yearly Budget" value="{budget>pieValue}"/>
															</viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds>
														<viz.feeds:FeedItem uid="size" type="Measure" values="Actual Yearly Budget"/>
														<viz.feeds:FeedItem uid="color" type="Dimension" values="Cost Centre Group"/>
													</viz:feeds>
													<viz:dependents>
														<viz:Popover id="top5PiePopoverGl"/>
													</viz:dependents>
												</viz:VizFrame>
											</suite:content>
										</suite:ChartContainerContent>
									</suite:content>
								</suite:ChartContainer>
							</layout:Grid>
						</content>
					</Panel>
